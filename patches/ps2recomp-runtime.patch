@@ -0,0 +1,1154 @@
+#pragma once
+
+// VU1 recompilado com o tempo resolvido na geracao (FUNCOES.md #67).
+//
+// tools/vu1_recomp.py emite, para cada microprograma, C++ direto por par de instrucoes: espera (so onde pode
+// haver espera), upper, lower, gravacao do upper e ++ciclo. Nao ha fila de pipeline por par: segue a mesma
+// semantica do modo rapido do interpretador (PS2X_VU1_FAST + PS2X_VU1_FAST_MATH), em que VF/ACC/VI sao
+// imediatos e o que tem atraso visivel fica em filas preguicosas, resolvidas so quando alguem le:
+//   - flags MAC/status/clip (+4 ciclos, em ordem de emissao; FSSET/FCSET anulam as do mesmo ciclo);
+//   - Q (DIV/SQRT 7, RSQRT 13) com status D/I; P (EFU) com recurso ocupado latencia-1;
+//   - PATH1 (XGKICK): o interpretador copia 1 qword a cada 2 ciclos; aqui o progresso e alcancado sob demanda
+//     (antes de cada store e de cada XGKICK), com as mesmas chamadas progressXgkick() por fronteira de ciclo.
+// Esperas reais: VI lido logo apos ILW/ILWR (latencia 4), FDIV, EFU, WAITQ/WAITP e XGKICK com PATH1 ocupado.
+// Na saida (fim ou PC fora do programa) o pendente volta para as filas do interpretador (materialize), que
+// termina exatamente como antes (flushPipelines no fim). Entrada so com as filas do interpretador vazias; bits D/T resolvidos no codigo gerado.
+
+#include "ps2_vu1_compiled.h"
+#include "runtime/gs/gs_draw_stats.h"
+
+#include <algorithm>
+#include <cmath>
+#include <immintrin.h>
+#include <cstring>
+#include <limits>
+
+struct Vu1Compiled::S
+{
+    enum : uint8_t
+    {
+        kMac = 1,
+        kStatus = 2,
+        kSticky = 4,
+        kClip = 8,
+    };
+    struct Flag
+    {
+        uint64_t ready;
+        uint32_t mac;
+        uint32_t status;
+        uint32_t clip;
+        uint8_t kind;
+        uint32_t extra = 0u; // sticky de gravacoes de flags eliminadas na geracao (ver fmacRes4<D, false>)
+    };
+    static constexpr uint32_t kRing = 16u;
+
+    struct Ctx
+    {
+        VU1Interpreter &vu;
+        VU1State &s;
+        Env &env;
+        uint8_t *data;
+        uint32_t mask;
+        uint64_t cyc;
+        alignas(16) float ur[4]; // resultado do upper do par atual (gravado depois do lower)
+
+        Flag ring[kRing];
+        uint32_t head = 0u;
+        uint32_t tail = 0u;
+        uint32_t pendingFsset = 0u;
+        uint32_t workingClip;
+        uint32_t carrySticky = 0u; // bits Z/S/U/O de gravacoes de flags eliminadas, somados a proxima entrada
+
+        bool fdivPending = false;
+        uint64_t fdivReady = 0u;
+        float fdivValue = 0.0f;
+        uint32_t fdivDi = 0u;
+
+        struct Efu
+        {
+            uint64_t ready = 0u;
+            float value = 0.0f;
+            bool valid = false;
+        } efu[2];
+        uint64_t efuResourceReady;
+
+        uint64_t viReady[16] = {};
+
+        bool kick = false;
+        uint64_t kickBoundary = 0u;
+
+        // regra do VI antigo: desvio logo apos uma escrita de VI le o valor anterior
+        uint8_t bkReg = 0u;
+        int32_t bkVal = 0;
+        uint64_t bkCyc = ~0ull;
+
+        uint32_t exitPc = 0u; // destino fora do programa (kExited): o despachante encadeia outro estatico
+
+        Ctx(VU1Interpreter &v, Env &e)
+            : vu(v), s(v.m_state), env(e), data(e.data), mask(e.dataSize - 1u), cyc(v.m_cycle),
+              workingClip(v.m_workingClip), efuResourceReady(v.m_efuResourceReady)
+        {
+        }
+
+        // ---- tempo ---------------------------------------------------------------------------------
+        inline void stallTo(uint64_t t)
+        {
+            if (t > cyc)
+                cyc = t;
+        }
+        inline void stallVi(uint32_t r)
+        {
+            stallTo(viReady[r]);
+        }
+
+        // ---- flags ---------------------------------------------------------------------------------
+        inline void applyFlag(const Flag &f)
+        {
+            if (f.kind & kMac)
+                s.mac = f.mac;
+            if (f.kind & kStatus)
+            {
+                const uint32_t cur = f.status & 0xFu;
+                s.status = (s.status & 0xFF0u) | cur | ((cur | f.extra) << 6);
+            }
+            if (f.kind & kSticky)
+                s.status = (s.status & 0x03Fu) | (f.status & 0xFC0u);
+            if (f.kind & kClip)
+                s.clip = f.clip;
+        }
+        inline void commitFdiv()
+        {
+            s.q = fdivValue;
+            const uint32_t di = fdivDi & 0x30u;
+            s.status = (s.status & 0xFCFu) | di | (di << 6);
+            fdivPending = false;
+        }
+        // Aplica tudo que ficou pronto ate o ciclo t, na ordem do interpretador (por ciclo; flags antes do Q)
+        inline void commitTo(uint64_t t)
+        {
+            while (head != tail && ring[head & (kRing - 1u)].ready <= t)
+            {
+                const Flag &f = ring[head & (kRing - 1u)];
+                if (fdivPending && fdivReady < f.ready)
+                    commitFdiv();
+                applyFlag(f);
+                if (f.kind & kSticky)
+                    --pendingFsset;
+                ++head;
+            }
+            if (fdivPending && fdivReady <= t)
+                commitFdiv();
+        }
+        inline void pushFlag(const Flag &f)
+        {
+            if (head != tail && ring[head & (kRing - 1u)].ready <= cyc)
+                commitTo(cyc);
+            ring[tail & (kRing - 1u)] = f;
+            ++tail;
+        }
+        inline uint32_t readMac()
+        {
+            commitTo(cyc);
+            return s.mac;
+        }
+        inline uint32_t readStatus()
+        {
+            commitTo(cyc);
+            return s.status;
+        }
+        inline uint32_t readClip()
+        {
+            commitTo(cyc);
+            return s.clip;
+        }
+        inline float q()
+        {
+            if (fdivPending && fdivReady <= cyc)
+                commitTo(cyc);
+            return s.q;
+        }
+
+        // ---- P (EFU) -----------------------------------------------------------------------------------
+        inline void commitEfu()
+        {
+            // em ordem de prontidao (o interpretador aplica uma fronteira de cada vez)
+            for (;;)
+            {
+                int best = -1;
+                for (int k = 0; k < 2; ++k)
+                    if (efu[k].valid && efu[k].ready <= cyc && (best < 0 || efu[k].ready < efu[best].ready))
+                        best = k;
+                if (best < 0)
+                    return;
+                s.p = efu[best].value;
+                efu[best].valid = false;
+            }
+        }
+
+        // ---- PATH1 -----------------------------------------------------------------------------------
+        inline void kickCatchUp(uint64_t t)
+        {
+            while (kick && kickBoundary < t)
+            {
+                ++kickBoundary;
+                vu.m_cycle = kickBoundary;
+                vu.progressXgkick();
+                kick = vu.m_xgkick.active;
+            }
+        }
+
+        // ---- memoria de dados ---------------------------------------------------------------------------
+        inline uint32_t addr(int32_t qword) const
+        {
+            return (static_cast<uint32_t>(qword) * 16u) & mask;
+        }
+        inline void storeWords(uint32_t a, const uint32_t words[4], uint8_t dest)
+        {
+            if (kick)
+                kickCatchUp(cyc);
+            uint32_t *dst = reinterpret_cast<uint32_t *>(data + a);
+            if (dest & 8u) dst[0] = words[0];
+            if (dest & 4u) dst[1] = words[1];
+            if (dest & 2u) dst[2] = words[2];
+            if (dest & 1u) dst[3] = words[3];
+        }
+    };
+
+    static inline bool reject(const char *why)
+    {
+        if (ps2_gs_stats::statsEnabled())
+            ps2_gs_stats::countEvent(why);
+        return false;
+    }
+    static inline bool canEnter(const VU1Interpreter &vu)
+    {
+        if (vu.m_flagValidMask || vu.m_storeValidMask || vu.m_vfValidMask || vu.m_viValidMask || vu.m_accValidMask)
+            return reject("vu1.static.no.fila");
+        if (vu.m_fdiv.valid || vu.m_efu[0].valid || vu.m_efu[1].valid || vu.m_xgkick.active)
+            return reject("vu1.static.no.qpk");
+        const VU1State &s = vu.m_state;
+        // D/T ligados sao tratados no codigo gerado (para no par com o bit, ou apos o delay slot)
+        if (s.branchPending || s.ebit || s.haltAfterDelaySlot || vu.m_viBranchBackupValid)
+            return reject("vu1.static.no.estado");
+        for (uint64_t r : vu.m_viReady)
+            if (r > vu.m_cycle)
+                return reject("vu1.static.no.vi");
+        return true;
+    }
+
+    // Devolve o pendente para as filas do interpretador (fim do programa ou saida para codigo nao compilado)
+    static inline void materialize(Ctx &c, uint32_t pc)
+    {
+        VU1Interpreter &vu = c.vu;
+        c.kickCatchUp(c.cyc);
+        vu.m_cycle = c.cyc;
+        c.s.cycles = c.cyc;
+        c.s.pc = pc;
+        c.commitTo(c.cyc);
+        c.commitEfu();
+        uint64_t next = UINT64_MAX;
+        uint32_t slot = 0u;
+        for (uint32_t i = c.head; i != c.tail; ++i, ++slot)
+        {
+            const Flag &f = c.ring[i & (kRing - 1u)];
+            auto &e = vu.m_flagPipeline[slot];
+            e = {};
+            e.valid = true;
+            e.readyCycle = f.ready;
+            e.issueCycle = f.ready - VU1Interpreter::kFmacLatency;
+            e.mac = f.mac;
+            e.status = f.status;
+            e.clip = f.clip;
+            e.writesMac = (f.kind & kMac) != 0u;
+            e.writesStatus = (f.kind & kStatus) != 0u;
+            e.writesSticky = (f.kind & kSticky) != 0u;
+            e.writesClip = (f.kind & kClip) != 0u;
+            e.extraSticky = f.extra;
+            vu.m_flagValidMask |= 1u << slot;
+            next = std::min(next, f.ready);
+        }
+        if (c.fdivPending)
+        {
+            vu.m_fdiv.valid = true;
+            vu.m_fdiv.readyCycle = c.fdivReady;
+            vu.m_fdiv.value = c.fdivValue;
+            vu.m_fdiv.statusDi = c.fdivDi;
+            next = std::min(next, c.fdivReady);
+        }
+        for (int k = 0; k < 2; ++k)
+        {
+            if (!c.efu[k].valid)
+                continue;
+            vu.m_efu[k].valid = true;
+            vu.m_efu[k].readyCycle = c.efu[k].ready;
+            vu.m_efu[k].value = c.efu[k].value;
+            next = std::min(next, c.efu[k].ready);
+        }
+        vu.m_efuResourceReady = c.efuResourceReady;
+        vu.m_workingClip = c.workingClip;
+        for (uint32_t r = 0; r < 16u; ++r)
+            if (c.viReady[r] > c.cyc)
+                vu.m_viReady[r] = c.viReady[r];
+        vu.m_nextCommitCycle = next;
+        vu.m_viBranchBackupValid = false;
+        c.s.vf[0][0] = 0.0f;
+        c.s.vf[0][1] = 0.0f;
+        c.s.vf[0][2] = 0.0f;
+        c.s.vf[0][3] = 1.0f;
+        c.s.vi[0] = 0;
+    }
+    static inline int finish(Ctx &c, uint32_t pc)
+    {
+        materialize(c, pc & 0x3FFFu);
+        return kEnded;
+    }
+    // Saida para fora do programa: o contexto continua vivo; tryRun encadeia outro estatico ou materializa
+    static inline int exitTo(Ctx &c, uint32_t pc)
+    {
+        c.exitPc = pc & 0x3FFFu;
+        return kExited;
+    }
+
+    // ---- aritmetica (mesmas expressoes do interpretador no modo rapido) ------------------------------------
+    static constexpr uint8_t laneBit(uint32_t comp) { return static_cast<uint8_t>(8u >> comp); }
+
+    static inline float normRes(float value, uint32_t &laneFlags)
+    {
+        uint32_t bits;
+        std::memcpy(&bits, &value, 4);
+        const uint32_t sign = bits & 0x80000000u;
+        const uint32_t magnitude = bits & 0x7FFFFFFFu;
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        laneFlags = sign != 0u ? 0x2u : 0u;
+        if (magnitude == 0u)
+            laneFlags |= 0x1u;
+        else if (exponent == 0u)
+        {
+            laneFlags |= 0x5u;
+            bits = sign;
+        }
+        else if (exponent == 0xFFu)
+        {
+            laneFlags |= 0x8u;
+            bits = sign | 0x7F7FFFFFu;
+        }
+        std::memcpy(&value, &bits, 4);
+        return value;
+    }
+    static inline float normResNoFlags(float value)
+    {
+        uint32_t f;
+        return normRes(value, f);
+    }
+
+    // Normaliza o resultado nas lanes do dest e emite as flags MAC/status (+4 ciclos)
+    template <uint8_t D>
+    static inline void fmacFlags(Ctx &c)
+    {
+        if constexpr (D != 0u)
+        {
+            uint32_t mac = 0u, status = 0u;
+            for (uint32_t k = 0; k < 4u; ++k)
+            {
+                if ((D & laneBit(k)) == 0u)
+                    continue;
+                uint32_t f;
+                c.ur[k] = normRes(c.ur[k], f);
+                const uint32_t lane = laneBit(k);
+                if (f & 0x1u) mac |= lane;
+                if (f & 0x2u) mac |= lane << 4;
+                if (f & 0x4u) mac |= lane << 8;
+                if (f & 0x8u) mac |= lane << 12;
+                status |= f;
+            }
+            c.pushFlag(Flag{c.cyc + VU1Interpreter::kFmacLatency, mac, status, 0u, static_cast<uint8_t>(kMac | kStatus)});
+        }
+    }
+
+    static inline void storeLanes(float *dst, const float *src, uint8_t dest)
+    {
+        if (dest & 8u) dst[0] = src[0];
+        if (dest & 4u) dst[1] = src[1];
+        if (dest & 2u) dst[2] = src[2];
+        if (dest & 1u) dst[3] = src[3];
+    }
+
+    // Classe do upper: 0 = nada, 1 = VF fd, 2 = VF ft, 3 = ACC, 4 = CLIP
+    template <uint32_t U>
+    static constexpr int upperKind()
+    {
+        constexpr uint32_t op = U & 0x3Fu;
+        if constexpr (op < 0x3Cu)
+            return op <= 0x2Fu ? 1 : -1;
+        else
+        {
+            constexpr uint32_t sp = (U & 3u) | ((U >> 4) & 0x7Cu);
+            if constexpr (sp == 0x2Fu || sp == 0x30u)
+                return 0;
+            else if constexpr (sp == 0x1Fu)
+                return 4;
+            else if constexpr ((sp >= 0x10u && sp <= 0x17u) || sp == 0x1Du)
+                return 2;
+            else if constexpr (sp <= 0x2Eu && sp != 0x2Bu)
+                return 3;
+            else
+                return -1;
+        }
+    }
+
+    // ---- upper vetorial (SSE): mesmas operacoes e ordem do escalar, 4 lanes de uma vez ----------------
+    // MAXPS/MINPS devolvem o 2o operando em empate/zeros, igual a (a > b ? a : b) / (a < b ? a : b).
+    static constexpr int rev4(uint32_t m) // mascara de lanes VU (x = 8) <-> ordem SSE (x = bit 0)
+    {
+        return static_cast<int>(((m >> 3) & 1u) | ((m >> 1) & 2u) | ((m << 1) & 4u) | ((m << 3) & 8u));
+    }
+    static inline __m128i blendi(__m128i a, __m128i b, __m128i m) // m: lanes todas 0 ou todas 1
+    {
+        return _mm_blendv_epi8(a, b, m);
+    }
+    // vuNormalizeOperandFast nas 4 lanes
+    static inline __m128 norm4(__m128 v)
+    {
+        const __m128i b = _mm_castps_si128(v);
+        const __m128i expMask = _mm_set1_epi32(0x7F800000);
+        const __m128i sign = _mm_and_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i e = _mm_and_si128(b, expMask);
+        __m128i r = blendi(b, sign, _mm_cmpeq_epi32(e, _mm_setzero_si128()));
+        r = blendi(r, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)), _mm_cmpeq_epi32(e, expMask));
+        return _mm_castsi128_ps(r);
+    }
+    // normRes nas 4 lanes + flags MAC/status das lanes de D (+4 ciclos)
+    // Live = false: o gerador provou que estas flags sao sobrescritas antes de qualquer leitura
+    // (tools/vu1_recomp.py, FUNCOES.md #71); so os bits sticky seguem, via carrySticky.
+    template <uint8_t D, bool Live = true>
+    static inline __m128 fmacRes4(Ctx &c, __m128 v)
+    {
+        const __m128i b = _mm_castps_si128(v);
+        const __m128i expMask = _mm_set1_epi32(0x7F800000);
+        const __m128i sign = _mm_and_si128(b, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i mag = _mm_and_si128(b, _mm_set1_epi32(0x7FFFFFFF));
+        const __m128i e = _mm_and_si128(b, expMask);
+        const __m128i magZero = _mm_cmpeq_epi32(mag, _mm_setzero_si128());
+        const __m128i under = _mm_andnot_si128(magZero, _mm_cmpeq_epi32(e, _mm_setzero_si128()));
+        const __m128i over = _mm_cmpeq_epi32(e, expMask);
+        __m128i r = blendi(b, sign, under);
+        r = blendi(r, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)), over);
+        if constexpr (D != 0u)
+        {
+            static constexpr uint32_t kRev[16] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
+            constexpr int dm = rev4(D);
+            const uint32_t zm = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_or_si128(magZero, under))) & dm);
+            const uint32_t sm = static_cast<uint32_t>(_mm_movemask_ps(v) & dm);
+            const uint32_t um = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(under)) & dm);
+            const uint32_t om = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(over)) & dm);
+            const uint32_t status = (zm ? 1u : 0u) | (sm ? 2u : 0u) | (um ? 4u : 0u) | (om ? 8u : 0u);
+            if constexpr (!Live)
+            {
+                c.carrySticky |= status;
+            }
+            else
+            {
+                const uint32_t mac = kRev[zm] | (kRev[sm] << 4) | (kRev[um] << 8) | (kRev[om] << 12);
+                c.pushFlag(Flag{c.cyc + VU1Interpreter::kFmacLatency, mac, status, 0u, static_cast<uint8_t>(kMac | kStatus),
+                                c.carrySticky});
+                c.carrySticky = 0u;
+            }
+        }
+        return _mm_castsi128_ps(r);
+    }
+
+    // Forma vetorial do upper: forma*16 + operando; -1 = caminho escalar
+    enum : int
+    {
+        kAdd = 0, kSub, kMadd, kMsub, kMax, kMin, kMul, kOpMsub, kOpMula,
+    };
+    enum : int
+    {
+        kBc0 = 0, kBc1, kBc2, kBc3, kQ, kI, kVec,
+    };
+    template <uint32_t U>
+    static constexpr int sseForm()
+    {
+        constexpr uint32_t op = U & 0x3Fu;
+        constexpr int qi[12][2] = {{kMul, kQ}, {kMax, kI}, {kMul, kI}, {kMin, kI}, {kAdd, kQ}, {kMadd, kQ},
+                                   {kAdd, kI}, {kMadd, kI}, {kSub, kQ}, {kMsub, kQ}, {kSub, kI}, {kMsub, kI}};
+        if constexpr (op < 0x3Cu)
+        {
+            constexpr int bcForms[7] = {kAdd, kSub, kMadd, kMsub, kMax, kMin, kMul};
+            constexpr int vec[8] = {kAdd, kMadd, kMul, kMax, kSub, kMsub, kOpMsub, kMin};
+            if constexpr (op <= 0x1Bu)
+                return bcForms[op >> 2] * 16 + static_cast<int>(op & 3u);
+            else if constexpr (op <= 0x27u)
+                return qi[op - 0x1Cu][0] * 16 + qi[op - 0x1Cu][1];
+            else if constexpr (op <= 0x2Fu)
+                return vec[op - 0x28u] * 16 + (vec[op - 0x28u] == kOpMsub ? 0 : kVec);
+            else
+                return -1;
+        }
+        else
+        {
+            constexpr uint32_t sp = (U & 3u) | ((U >> 4) & 0x7Cu);
+            constexpr int bcForms[4] = {kAdd, kSub, kMadd, kMsub};
+            if constexpr (sp <= 0x0Fu)
+                return bcForms[sp >> 2] * 16 + static_cast<int>(sp & 3u);
+            else if constexpr (sp >= 0x18u && sp <= 0x1Bu)
+                return kMul * 16 + static_cast<int>(sp & 3u);
+            else if constexpr (sp == 0x1Cu)
+                return kMul * 16 + kQ;
+            else if constexpr (sp == 0x1Eu)
+                return kMul * 16 + kI;
+            else if constexpr (sp >= 0x20u && sp <= 0x27u)
+                return qi[sp - 0x1Cu][0] * 16 + qi[sp - 0x1Cu][1];
+            else if constexpr (sp == 0x28u) return kAdd * 16 + kVec;
+            else if constexpr (sp == 0x29u) return kMadd * 16 + kVec;
+            else if constexpr (sp == 0x2Au) return kMul * 16 + kVec;
+            else if constexpr (sp == 0x2Cu) return kSub * 16 + kVec;
+            else if constexpr (sp == 0x2Du) return kMsub * 16 + kVec;
+            else if constexpr (sp == 0x2Eu) return kOpMula * 16;
+            else
+                return -1;
+        }
+    }
+
+    // Calcula o upper em c.ur (e emite flags/clip); a gravacao fica para upperStore, depois do lower
+    template <uint32_t U, bool Live = true>
+    static inline void upper(Ctx &c)
+    {
+        constexpr int kind = upperKind<U>();
+        static_assert(kind >= 0, "upper nao suportado pelo VU1 estatico");
+        constexpr uint32_t op = U & 0x3Fu;
+        constexpr uint8_t D = static_cast<uint8_t>((U >> 21) & 0xFu);
+        constexpr uint32_t ft = (U >> 16) & 0x1Fu;
+        constexpr uint32_t fs = (U >> 11) & 0x1Fu;
+        VU1State &s = c.s;
+        float *r = c.ur;
+        if constexpr (kind == 0)
+            return;
+        else if constexpr (kind == 4)
+        {
+            // CLIP: usa os valores crus de VF (sem normalizar), como o interpretador
+            uint32_t wBits;
+            std::memcpy(&wBits, &s.vf[ft][3], 4);
+            const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+            auto exceeds = [limit](float value, uint32_t signMask) {
+                uint32_t bits;
+                std::memcpy(&bits, &value, 4);
+                bits ^= signMask;
+                int32_t ordered;
+                std::memcpy(&ordered, &bits, 4);
+                return ordered > limit;
+            };
+            uint32_t flags = 0u;
+            if (exceeds(s.vf[fs][0], 0u)) flags |= 0x01u;
+            if (exceeds(s.vf[fs][0], 0x80000000u)) flags |= 0x02u;
+            if (exceeds(s.vf[fs][1], 0u)) flags |= 0x04u;
+            if (exceeds(s.vf[fs][1], 0x80000000u)) flags |= 0x08u;
