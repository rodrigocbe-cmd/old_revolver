+        constexpr uint32_t op = U & 0x3Fu;
+        constexpr uint8_t dest = static_cast<uint8_t>((U >> 21) & 0xFu);
+        constexpr uint8_t ft = static_cast<uint8_t>((U >> 16) & 0x1Fu);
+        constexpr uint8_t fs = static_cast<uint8_t>((U >> 11) & 0x1Fu);
