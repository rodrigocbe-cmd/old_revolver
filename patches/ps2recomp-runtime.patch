+    // ---- esperas do lower (antes do par) -------------------------------------------------------------------
+    template <uint32_t L>
+    static inline void lowerWait(Ctx &c)
+    {
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        constexpr uint32_t sp = (L & 3u) | ((L >> 4) & 0x7Cu);
+        constexpr bool special = opHi == 0x40u && (L & 0x3Fu) >= 0x3Cu;
+        if constexpr (special && (sp == 0x38u || sp == 0x39u || sp == 0x3Au || sp == 0x3Bu)) // FDIV / WAITQ
+        {
+            if (c.fdivPending)
+                c.stallTo(c.fdivReady);
+        }
+        else if constexpr (special && ((sp >= 0x70u && sp <= 0x7Au) || sp == 0x7Cu || sp == 0x7Du)) // EFU
+            c.stallTo(c.efuResourceReady);
+        else if constexpr (special && sp == 0x7Bu) // WAITP
+        {
+            for (int k = 0; k < 2; ++k)
+                if (c.efu[k].valid)
+                    c.stallTo(c.efu[k].ready);
+        }
+    }
+    // XGKICK espera PATH1 livre; fica por ultimo porque avanca ciclo a ciclo
+    static inline void xgkickWait(Ctx &c)
+    {
+        if (!c.kick)
+            return;
+        c.kickCatchUp(c.cyc);
+        while (c.kick)
+        {
+            c.kickCatchUp(c.cyc + 1u);
+            ++c.cyc;
+        }
+    }
