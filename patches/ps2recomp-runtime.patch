+// ---- IOP numa thread propria do host (FUNCOES.md #69) ------------------------------------------------------
+// No PS2 o IOP roda em paralelo ao EE. Aqui ele avancava dentro de accountCycles(), na thread do jogo (~30% dela).
+// Agora accountCycles so soma os ciclos do EE; a thread "IopWorker" roda runEeCycles em fatias curtas sob um mutex
+// que tambem protege toda entrada EE->IOP (RPC, SIF DMA, carga de modulo, memoria do IOP). Contrapressao: se o IOP
+// ficar mais de kIopMaxLag ciclos do EE atras, a thread do jogo espera. Comandos SIF enviados pelo codigo do IOP
+// (isceSifSendCmd) executam handlers do EE, entao vao para uma fila esvaziada na thread do jogo (evento Dmac vazio acorda o escalonador).
+// PS2X_IOP_THREAD=0 volta a rodar o IOP na thread do jogo.
+namespace
+{
+    constexpr uint64_t kIopChunkEeCycles = 100000u;  // ~12,5 mil ciclos do IOP por posse do mutex
+    constexpr uint64_t kIopMaxLag = 2000000u;        // ~0,4 VBlank de atraso maximo do IOP
+
+    struct IopWorkerState
+    {
+        std::recursive_mutex iop; // estado do IOP (todas as entradas)
+        std::mutex wakeMutex;
+        std::condition_variable wakeCv;
+        std::condition_variable doneCv;
+        std::atomic<uint64_t> pending{0u};
+        std::atomic<bool> stop{false};
+        std::atomic<bool> started{false};
+        std::thread thread;
+        PS2Runtime *runtime = nullptr;
+        std::mutex sifMutex;
+        std::vector<std::pair<uint32_t, std::vector<uint8_t>>> sifQueue;
+        std::atomic<bool> sifPending{false};
+    } g_iopWorker;
+    thread_local bool t_onIopWorker = false;
+
+    bool iopThreadEnabled()
+    {
+        static const bool enabled = []() {
+            const char *v = std::getenv("PS2X_IOP_THREAD");
+            return !v || std::atoi(v) != 0;
+        }();
+        return enabled;
+    }
+}
+
+bool ps2IopOnWorkerThread() noexcept
+{
+    return t_onIopWorker;
+}
