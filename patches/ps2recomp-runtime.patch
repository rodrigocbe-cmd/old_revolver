+                else if constexpr (special <= 0x0Bu) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] + vs[c] * vt[bc]; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special <= 0x0Fu) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] - vs[c] * vt[bc]; fmacStore(vu, s.acc, result, dest); }
