+void ps2QueueIopSifCommand(uint32_t commandId, const void *packet, size_t packetSize)
+{
+    {
+        std::lock_guard<std::mutex> lock(g_iopWorker.sifMutex);
+        const uint8_t *bytes = static_cast<const uint8_t *>(packet);
+        g_iopWorker.sifQueue.emplace_back(commandId, std::vector<uint8_t>(bytes, bytes + packetSize));
+        g_iopWorker.sifPending.store(true, std::memory_order_release);
+    }
+    if (g_iopWorker.runtime)
+        g_iopWorker.runtime->eeScheduler().postEvent(EeEvent{EeEventType::Dmac, 0u, 0u}); // so acorda o escalonador (Dmac nao faz nada no processEvent)
+}
+
+// Thread do jogo: entrega os comandos SIF que o IOP enviou (chamado em accountCycles e em processPendingEvents)
+// FINISH/SIGNAL do GS na GPU chegam pela thread de submissao: acorda o escalonador do EE (evento Dmac vazio)
+static void wakeEeForGsSignal()
+{
+    if (g_iopWorker.runtime)
+        g_iopWorker.runtime->eeScheduler().postEvent(EeEvent{EeEventType::Dmac, 0u, 0u});
+}
+
+void ps2DrainIopSifCommands()
+{
+    if (!g_iopWorker.sifPending.load(std::memory_order_acquire) || !g_iopWorker.runtime)
+        return;
+    std::vector<std::pair<uint32_t, std::vector<uint8_t>>> queue;
+    {
+        std::lock_guard<std::mutex> lock(g_iopWorker.sifMutex);
+        queue.swap(g_iopWorker.sifQueue);
+        g_iopWorker.sifPending.store(false, std::memory_order_release);
+    }
+    PS2Runtime *runtime = g_iopWorker.runtime;
+    for (auto &[commandId, packet] : queue)
+        ps2_stubs::dispatchSifCommand(runtime->memory().getRDRAM(), runtime, commandId, packet.data(), packet.size());
+}
+
+static void stopIopWorker()
+{
+    if (!g_iopWorker.started.load())
+        return;
+    g_iopWorker.stop.store(true);
+    g_iopWorker.wakeCv.notify_all();
+    g_iopWorker.doneCv.notify_all();
+    if (g_iopWorker.thread.joinable())
+        g_iopWorker.thread.join();
+    g_iopWorker.started.store(false);
+}
