+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+struct GSRegisters;
+
+// Ponte opcional para o paraLLEl-GS (GS em compute Vulkan na GPU, FUNCOES.md #65).
+// Ativa com PS2X_GS_BACKEND=parallel num build com PS2X_PARALLEL_GS_DIR. Quando ativa, todo o fluxo GIF que
+// chegaria ao GS de software vai para a GPU e a apresentacao le a imagem de scanout do paraLLEl-GS.
+namespace ps2_gs_parallel
+{
+    // Inicializa na primeira chamada (Vulkan + GSInterface). Falha de init => false e o GS de software segue.
+    bool active();
+    void bindPrivRegs(GSRegisters *regs);
+    // Chamado (de outra thread) quando FINISH/SIGNAL chegam pela thread de submissao: acorda o escalonador do EE
+    void setSignalWake(void (*wake)());
+
+    // Caminho GIF (1..3) do pacote atual; o GifArbiter marca antes de entregar cada pacote.
+    void setCurrentPath(uint32_t path);
+
+    void gifTransfer(const uint8_t *data, uint32_t sizeBytes);
+    void writeRegister(uint8_t regAddr, uint64_t value);
+    void uploadImage(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                     const uint8_t *data, uint32_t sizeBytes);
+    uint32_t readTransfer(uint8_t *dst, uint32_t maxBytes);
+
+    // VBlank: copia os registradores privilegiados, faz o scanout e devolve RGBA8 (alpha = 0xFF).
+    bool present(const GSRegisters &regs, uint32_t phase, std::vector<uint8_t> &outPixels,
+                 uint32_t &outWidth, uint32_t &outHeight);
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
new file mode 100644
index 0000000..b1fac39
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
@@ -0,0 +1,335 @@
+#include "gs_threaded_backend.h"
+
+#include "runtime/gs/gs_draw_stats.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+namespace
+{
+    // Limite da fila (comandos): acima disso a thread do jogo espera o GS alcancar, para a memoria nao
+    // crescer sem fim e o atraso de apresentacao ficar limitado.
+    constexpr size_t kMaxQueuedCommands = 32768u;
+    // Primitivas por lote de faixas; lotes menores que kMinParallelRun vao direto (sem sincronizar threads).
+    constexpr size_t kMaxRun = 1024u;
+    constexpr size_t kMinParallelRun = 8u;
+    // Altura das fatias intercaladas: a faixa b desenha as linhas [y0 + (k*N + b)*kSliceRows, ...).
+    constexpr int kSliceRows = 16;
+
+    bool sameTarget(const GSPrimitiveBatch &a, const GSPrimitiveBatch &b)
+    {
+        const GSContext &x = a.state.context;
+        const GSContext &y = b.state.context;
+        return x.scissor.x0 == y.scissor.x0 && x.scissor.x1 == y.scissor.x1 && x.scissor.y0 == y.scissor.y0 &&
+               x.scissor.y1 == y.scissor.y1 && x.frame.fbp == y.frame.fbp && x.frame.fbw == y.frame.fbw &&
+               x.frame.psm == y.frame.psm && x.zbuf.zbp == y.zbuf.zbp && x.zbuf.psm == y.zbuf.psm;
+    }
+
+    uint32_t bandCountFromEnvironment()
+    {
+        if (const char *env = std::getenv("PS2X_GS_BANDS"))
+            return static_cast<uint32_t>(std::clamp(std::atoi(env), 1, 16));
+        const int hw = static_cast<int>(std::thread::hardware_concurrency());
+        // medido no RDR (16 nucleos): 2->41, 4->61, 5->62, 8->55 quadros/600 vblanks; acima de 5 a sincronizacao
+        // e a disputa com a thread do jogo custam mais do que rendem (FUNCOES.md #64)
+        return static_cast<uint32_t>(std::clamp(hw - 2, 1, 5));
+    }
+}
+
+bool GSThreadedBackend::EnabledByEnvironment()
+{
+    const char *env = std::getenv("PS2X_GS_THREAD");
+    return !env || std::atoi(env) != 0;
+}
+
+GSThreadedBackend::GSThreadedBackend(std::unique_ptr<GSCpuBackend> inner)
+    : m_inner(std::move(inner))
+{
+    m_bandCount = bandCountFromEnvironment();
+    if (m_bandCount > 1u)
+        for (uint32_t b = 0; b < m_bandCount; ++b)
+            m_bandThreads.emplace_back([this, b]() { BandLoop(b); });
+    std::fprintf(stderr, "[gs] backend em thread propria, %u faixa(s) de rasterizacao\n", m_bandCount);
+    m_worker = std::thread([this]() { WorkerLoop(); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_stop = true;
+    }
+    m_workAvailable.notify_all();
+    if (m_worker.joinable())
+        m_worker.join();
+    {
+        std::lock_guard<std::mutex> lock(m_bandMutex);
+        m_bandStop = true;
+    }
+    m_bandStart.notify_all();
+    for (std::thread &t : m_bandThreads)
+        if (t.joinable())
+            t.join();
+}
+
+void GSThreadedBackend::BandLoop(uint32_t band)
+{
+    uint64_t seen = 0;
+    for (;;)
+    {
+        const std::vector<GSPrimitiveBatch> *run = nullptr;
+        {
+            std::unique_lock<std::mutex> lock(m_bandMutex);
+            m_bandStart.wait(lock, [&]() { return m_bandStop || m_bandGeneration != seen; });
+            if (m_bandStop)
+                return;
+            seen = m_bandGeneration;
+            run = m_bandRun;
+        }
+        const int stride = static_cast<int>(m_bandCount) * kSliceRows;
+        for (const GSPrimitiveBatch &batch : *run)
+        {
+            const GSScissorReg &sc = batch.state.context.scissor;
+            GSPrimitiveBatch local = batch;
+            for (int y = static_cast<int>(sc.y0) + static_cast<int>(band) * kSliceRows; y <= static_cast<int>(sc.y1);
+                 y += stride)
+            {
+                local.state.context.scissor.y0 = static_cast<uint16_t>(y);
+                local.state.context.scissor.y1 = static_cast<uint16_t>(std::min<int>(y + kSliceRows - 1, sc.y1));
+                m_inner->SubmitBand(local);
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_bandMutex);
+            if (--m_bandRemaining == 0u)
+                m_bandDone.notify_all();
+        }
+    }
+}
+
+void GSThreadedBackend::DrawRun(std::vector<GSPrimitiveBatch> &run)
+{
+    if (run.empty())
+        return;
+    // Rastreio de depuracao (F9) conta primitivas por chamada: fica serial para nao duplicar.
+    if (m_bandCount <= 1u || run.size() < kMinParallelRun || ps2_gs_stats::primTraceActive())
+    {
+        for (const GSPrimitiveBatch &batch : run)
+            m_inner->Submit(batch);
+        run.clear();
+        return;
+    }
+    std::unique_lock<std::mutex> lock(m_bandMutex);
+    m_bandRun = &run;
+    m_bandRemaining = m_bandCount;
+    ++m_bandGeneration;
+    m_bandStart.notify_all();
+    m_bandDone.wait(lock, [this]() { return m_bandRemaining == 0u; });
+    m_bandRun = nullptr;
+    lock.unlock();
+    run.clear();
+}
+
+void GSThreadedBackend::Push(Command &&command)
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    m_spaceAvailable.wait(lock, [this]() { return m_queue.size() < kMaxQueuedCommands || m_stop; });
+    m_queue.push_back(std::move(command));
+    lock.unlock();
+    m_workAvailable.notify_one();
+}
+
+void GSThreadedBackend::Drain() const
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    m_idle.wait(lock, [this]() { return (m_queue.empty() && !m_busy) || m_stop; });
+}
+
+void GSThreadedBackend::WorkerLoop()
+{
+    std::vector<GSPrimitiveBatch> run;
+    run.reserve(kMaxRun);
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    for (;;)
+    {
+        m_workAvailable.wait(lock, [this]() { return !m_queue.empty() || m_stop; });
+        if (m_queue.empty() && m_stop)
+            break;
+        Command command = std::move(m_queue.front());
+        m_queue.pop_front();
+        m_busy = true;
+        if (command.type == CommandType::Submit)
+        {
+            // Junta as primitivas seguintes com o mesmo alvo num lote para as faixas
+            run.push_back(command.batch);
+            while (!m_queue.empty() && run.size() < kMaxRun && m_queue.front().type == CommandType::Submit &&
+                   sameTarget(m_queue.front().batch, run.front()))
+            {
+                run.push_back(m_queue.front().batch);
+                m_queue.pop_front();
+            }
+            lock.unlock();
+            m_spaceAvailable.notify_all();
+            DrawRun(run);
+        }
+        else
+        {
+            lock.unlock();
+            m_spaceAvailable.notify_all();
+            Execute(command);
+        }
+
+        lock.lock();
+        m_busy = false;
+        if (m_queue.empty())
+            m_idle.notify_all();
+    }
+    m_idle.notify_all();
+}
+
+void GSThreadedBackend::Execute(Command &command)
+{
+    switch (command.type)
+    {
+    case CommandType::Submit:
+        m_inner->Submit(command.batch);
+        break;
+    case CommandType::LoadClut:
+        m_inner->LoadClut(command.tex0, command.texclut);
+        break;
+    case CommandType::BeginTransfer:
+        m_inner->BeginTransfer(command.transfer);
+        break;
+    case CommandType::UploadImage:
+        m_inner->UploadImage(command.data.data(), static_cast<uint32_t>(command.data.size()));
+        break;
+    case CommandType::TextureFlush:
+        m_inner->TextureFlush();
+        break;
+    case CommandType::WriteVram:
+        m_inner->WriteVram(command.args[0], command.args[1], command.args[2], command.args[3], command.args[4],
+                           command.args[5]);
+        break;
+    }
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    Drain();
+    m_inner->Initialize(vram, vramSize);
+}
+
+void GSThreadedBackend::Reset()
+{
+    Drain();
+    m_inner->Reset();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    Command command;
+    command.type = CommandType::Submit;
+    command.batch = batch;
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Command command;
+    command.type = CommandType::LoadClut;
+    command.tex0 = tex0;
+    command.texclut = texclut;
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &transfer)
+{
+    Command command;
+    command.type = CommandType::BeginTransfer;
+    command.transfer = transfer;
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u)
+        return;
+    Command command;
+    command.type = CommandType::UploadImage;
+    command.data.assign(data, data + sizeBytes);
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::Flush()
+{
+    // Flush/Sync do frontend chegam juntos; a espera fica no Sync, que sabe o motivo.
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    Command command;
+    command.type = CommandType::TextureFlush;
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    // A apresentacao (thread da janela) le o buffer exibido, que o jogo nao esta desenhando; esperar a
+    // fila ali deixaria a janela presa ao ritmo do jogo. Os demais motivos (FINISH, reset, leitura)
+    // precisam ver todo o desenho anterior.
+    if (reason != GSSyncReason::Presentation)
+        Drain();
+    m_inner->Flush();
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    return m_inner->Present(request);
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    Drain();
+    return m_inner->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    Drain();
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    Drain();
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    Command command;
+    command.type = CommandType::WriteVram;
+    command.args[0] = psm;
+    command.args[1] = base;
+    command.args[2] = bw;
+    command.args[3] = x;
+    command.args[4] = y;
+    command.args[5] = value;
+    Push(std::move(command));
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    Drain();
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    // So para depuracao/historico: le o estado atual sem esperar a fila.
+    return m_inner->GetTransferSnapshot();
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.h b/ps2xRuntime/src/lib/gs/gs_threaded_backend.h
new file mode 100644
index 0000000..de1866d
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.h
@@ -0,0 +1,103 @@
+#pragma once
+
+// Backend do GS em thread propria (FUNCOES.md #55). Envolve outro GSRasterBackend (o GSCpuBackend):
+// comandos que so escrevem na VRAM (primitivas, CLUT, uploads, transferencias) entram numa fila e sao
+// executados em ordem por uma thread trabalhadora; comandos que leem estado/VRAM esvaziam a fila antes.
+// Assim a thread do jogo (EE + VU1 + frontend do GS) segue produzindo enquanto a rasterizacao corre em
+// outro nucleo. PS2X_GS_THREAD=0 desliga (volta ao backend sincrono).
+// Faixas (FUNCOES.md #56): sequencias de primitivas com o mesmo scissor/FRAME/ZBUF sao desenhadas por
+// PS2X_GS_BANDS threads (padrao: nucleos - 2, max. 5), cada uma com o scissor cortado em fatias de linhas
+// intercaladas; cada pixel e sempre da mesma thread, entao a ordem por pixel e a do PS2. Qualquer outro
+// comando (CLUT, upload, TEXFLUSH, transferencia) funciona como barreira.
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <condition_variable>
+#include <cstddef>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(std::unique_ptr<GSCpuBackend> inner);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    // true quando PS2X_GS_THREAD nao desliga o modo em thread
+    static bool EnabledByEnvironment();
+
+private:
+    enum class CommandType : uint8_t
+    {
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        UploadImage,
+        TextureFlush,
+        WriteVram,
+    };
+
+    struct Command
+    {
+        CommandType type = CommandType::Submit;
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+        std::vector<uint8_t> data;
+        uint32_t args[6] = {};
+    };
+
+    void Push(Command &&command);
+    void Drain() const;
+    void WorkerLoop();
+    void Execute(Command &command);
+    void DrawRun(std::vector<GSPrimitiveBatch> &run);
+    void BandLoop(uint32_t band);
+
+    std::unique_ptr<GSCpuBackend> m_inner;
+
+    // Pool de faixas
+    uint32_t m_bandCount = 1;
+    std::vector<std::thread> m_bandThreads;
+    std::mutex m_bandMutex;
+    std::condition_variable m_bandStart;
+    std::condition_variable m_bandDone;
+    const std::vector<GSPrimitiveBatch> *m_bandRun = nullptr;
+    uint64_t m_bandGeneration = 0;
+    uint32_t m_bandRemaining = 0;
+    bool m_bandStop = false;
+    mutable std::mutex m_queueMutex;
+    mutable std::condition_variable m_workAvailable;
+    mutable std::condition_variable m_idle;
+    mutable std::condition_variable m_spaceAvailable;
+    std::deque<Command> m_queue;
+    bool m_busy = false;
+    bool m_stop = false;
+    std::thread m_worker;
+};
