+        constexpr int kind = upperKind<U>();
+        constexpr uint8_t D = static_cast<uint8_t>((U >> 21) & 0xFu);
+        constexpr uint32_t ft = (U >> 16) & 0x1Fu;
+        constexpr uint32_t fd = (U >> 6) & 0x1Fu;
+        constexpr int imm = rev4(D);
+        float *dst = nullptr;
+        if constexpr (kind == 1 && fd != 0u)
+            dst = c.s.vf[fd];
+        else if constexpr (kind == 2 && ft != 0u)
+            dst = c.s.vf[ft];
+        else if constexpr (kind == 3)
+            dst = c.s.acc;
+        if constexpr (imm != 0 && ((kind == 1 && fd != 0u) || (kind == 2 && ft != 0u) || kind == 3))
+            _mm_storeu_ps(dst, _mm_blend_ps(_mm_loadu_ps(dst), _mm_load_ps(c.ur), imm));
+    }
