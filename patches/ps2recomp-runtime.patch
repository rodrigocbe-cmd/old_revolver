+                vt[c] = vuNormalizeOperandFast(s.vf[ft][c]);
+                acc[c] = vuNormalizeOperandFast(s.acc[c]);
+            }
+            const float q = vuNormalizeOperandFast(s.q);
+            const float i = vuNormalizeOperandFast(s.i);
