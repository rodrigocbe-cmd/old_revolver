+                else if constexpr (special == 0x1Du) { for (uint32_t c = 0; c < 4u; ++c) result[c] = std::fabs(vs[c]); plainStore(vtDest, result, dest); }
+                else if constexpr (special == 0x1Eu) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] * i; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x20u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] + q; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x21u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] + vs[c] * q; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x22u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] + i; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x23u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] + vs[c] * i; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x24u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] - q; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x25u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] - vs[c] * q; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x26u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] - i; fmacStore(vu, s.acc, result, dest); }
+                else if constexpr (special == 0x27u) { for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] - vs[c] * i; fmacStore(vu, s.acc, result, dest); }
