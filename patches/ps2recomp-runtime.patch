diff --git a/ps2xRuntime/src/lib/ps2_debug_menu.cpp b/ps2xRuntime/src/lib/ps2_debug_menu.cpp
new file mode 100644
index 0000000..8b89188
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_debug_menu.cpp
@@ -0,0 +1,429 @@
+// Menu de debug para testes (FUNCOES.md #73): F11 abre por cima do jogo.
+//
+// Aba Busca (Tab troca de aba) - Busca de memoria (estilo Cheat Engine) na RAM do PS2 com o jogo rodando: tipo (u8/u16/u32/f32),
+//   valor digitado, nova busca, filtros (= valor, mudou, nao mudou, diminuiu, aumentou); escreve, congela e
+//   salva candidatos em config/cheats.txt (vira entrada da aba 2) e em logs/debug_found.txt.
+// Aba 2 - Trapacas: entradas de config/cheats.txt ("nome;endereco;tipo;valor"), congelar/editar.
+// Enquanto aberto, o jogo ve o controle em repouso (ps2PadSetBlocked). Enderecos confirmados vao para
+// docs/MEMORIA.md.
+
+#include "ps2_runtime.h"
+#include "ps2_host_backend.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+void ps2PadSetBlocked(bool blocked); // ps2_pad.cpp
+
+namespace
+{
+    constexpr uint32_t kRamSize = 32u << 20;
+
+    enum class ValType
+    {
+        U8,
+        U16,
+        U32,
+        F32
+    };
+    const char *typeName(ValType t)
+    {
+        switch (t)
+        {
+        case ValType::U8: return "u8";
+        case ValType::U16: return "u16";
+        case ValType::U32: return "u32";
+        default: return "f32";
+        }
+    }
+    uint32_t typeSize(ValType t)
+    {
+        return t == ValType::U8 ? 1u : t == ValType::U16 ? 2u : 4u;
+    }
+    ValType typeFromName(const std::string &s)
+    {
+        if (s == "u8") return ValType::U8;
+        if (s == "u16") return ValType::U16;
+        if (s == "f32") return ValType::F32;
+        return ValType::U32;
+    }
+
+    uint32_t readRaw(const uint8_t *ram, uint32_t addr, ValType t)
+    {
+        uint32_t v = 0u;
+        std::memcpy(&v, ram + addr, typeSize(t));
+        return v;
+    }
+    void writeRaw(uint8_t *ram, uint32_t addr, ValType t, uint32_t raw)
+    {
+        std::memcpy(ram + addr, &raw, typeSize(t));
+    }
+    std::string format(uint32_t raw, ValType t)
+    {
+        char buf[64];
+        if (t == ValType::F32)
+        {
+            float f;
+            std::memcpy(&f, &raw, 4);
+            std::snprintf(buf, sizeof(buf), "%g", f);
+        }
+        else
+            std::snprintf(buf, sizeof(buf), "%u", raw);
+        return buf;
+    }
+    bool parseRaw(const std::string &text, ValType t, uint32_t &raw)
+    {
+        if (text.empty())
+            return false;
+        char *end = nullptr;
+        if (t == ValType::F32)
+        {
+            const float f = std::strtof(text.c_str(), &end);
+            std::memcpy(&raw, &f, 4);
+        }
+        else
+        {
+            const long long v = std::strtoll(text.c_str(), &end, 0);
+            raw = static_cast<uint32_t>(v);
+            if (t == ValType::U8) raw &= 0xFFu;
+            if (t == ValType::U16) raw &= 0xFFFFu;
+        }
+        return end && *end == '\0';
+    }
+    double asNumber(uint32_t raw, ValType t)
+    {
+        if (t == ValType::F32)
+        {
+            float f;
+            std::memcpy(&f, &raw, 4);
+            return f;
+        }
+        return static_cast<double>(raw);
+    }
+
+    struct Cheat
+    {
+        std::string name;
+        uint32_t addr = 0u;
+        ValType type = ValType::U32;
+        uint32_t raw = 0u;
+        bool frozen = false;
+    };
+
+    struct DebugMenu
+    {
+        bool open = false;
+        bool releasePending = false;
+        int tab = 0; // 0 busca, 1 trapacas
+        ValType type = ValType::U32;
+        std::string input;
+        std::vector<uint32_t> cands; // enderecos
+        std::vector<uint32_t> prev;  // valores na ultima filtragem
+        bool scanned = false;
+        int sel = 0;
+        std::string status = "F11 fecha | Tab troca de aba";
+        std::vector<Cheat> cheats;
+        bool cheatsLoaded = false;
+        std::vector<uint32_t> frozenAddr; // congelados da aba de busca
+        std::vector<uint32_t> frozenRaw;
+        std::vector<ValType> frozenType;
+    } g_dbg;
+
+    const char *kCheatsFile = "config/cheats.txt";
+
+    std::string projectPath(const char *rel)
+    {
+        // o runner roda com o diretorio de trabalho em game/disc; sobe ate a raiz do projeto
+        for (const char *prefix : {"", "../", "../../"})
+        {
+            const std::string probe = std::string(prefix) + "docs/MEMORIA.md";
+            if (std::ifstream(probe).good())
+                return std::string(prefix) + rel;
+        }
+        return rel;
+    }
+
+    void loadCheats()
+    {
+        g_dbg.cheats.clear();
+        std::ifstream in(projectPath(kCheatsFile));
+        std::string line;
+        while (std::getline(in, line))
+        {
+            if (line.empty() || line[0] == '#')
+                continue;
+            std::stringstream ss(line);
+            std::string name, addr, type, value;
+            std::getline(ss, name, ';');
+            std::getline(ss, addr, ';');
+            std::getline(ss, type, ';');
+            std::getline(ss, value, ';');
+            Cheat c;
+            c.name = name;
+            c.addr = static_cast<uint32_t>(std::strtoul(addr.c_str(), nullptr, 0)) & (kRamSize - 1u);
+            c.type = typeFromName(type);
+            parseRaw(value, c.type, c.raw);
+            g_dbg.cheats.push_back(c);
+        }
+        g_dbg.cheatsLoaded = true;
+    }
+
+    void saveCandidate(const uint8_t *ram, uint32_t addr)
+    {
+        const uint32_t raw = readRaw(ram, addr, g_dbg.type);
+        char line[160];
+        std::snprintf(line, sizeof(line), "novo_%08x;0x%08x;%s;%s", addr, addr, typeName(g_dbg.type), format(raw, g_dbg.type).c_str());
+        std::ofstream(projectPath(kCheatsFile), std::ios::app) << line << "\n";
+        std::ofstream(projectPath("logs/debug_found.txt"), std::ios::app) << line << "\n";
+        loadCheats();
+        g_dbg.status = std::string("salvo em config/cheats.txt: ") + line;
+    }
+
+    void newScan(const uint8_t *ram)
+    {
+        uint32_t target = 0u;
+        const bool hasValue = parseRaw(g_dbg.input, g_dbg.type, target);
+        const uint32_t step = typeSize(g_dbg.type);
+        g_dbg.cands.clear();
+        g_dbg.prev.clear();
+        for (uint32_t a = 0; a + step <= kRamSize; a += step)
+        {
+            const uint32_t v = readRaw(ram, a, g_dbg.type);
+            if (!hasValue || v == target)
+            {
+                g_dbg.cands.push_back(a);
+                g_dbg.prev.push_back(v);
+            }
+        }
+        g_dbg.scanned = true;
+        g_dbg.sel = 0;
+        g_dbg.status = std::to_string(g_dbg.cands.size()) + (hasValue ? " candidatos (= valor)" : " candidatos (todos: use os filtros)");
+    }
+
+    // modo: 0 = valor, 1 mudou, 2 nao mudou, 3 diminuiu, 4 aumentou
+    void filter(const uint8_t *ram, int mode)
+    {
+        uint32_t target = 0u;
+        if (mode == 0 && !parseRaw(g_dbg.input, g_dbg.type, target))
+        {
+            g_dbg.status = "digite um valor";
+            return;
+        }
+        size_t out = 0;
+        for (size_t i = 0; i < g_dbg.cands.size(); ++i)
+        {
+            const uint32_t v = readRaw(ram, g_dbg.cands[i], g_dbg.type);
+            const double nv = asNumber(v, g_dbg.type), ov = asNumber(g_dbg.prev[i], g_dbg.type);
+            bool keep = false;
+            switch (mode)
+            {
+            case 0: keep = v == target; break;
+            case 1: keep = v != g_dbg.prev[i]; break;
+            case 2: keep = v == g_dbg.prev[i]; break;
+            case 3: keep = nv < ov; break;
+            default: keep = nv > ov; break;
+            }
+            if (keep)
+            {
+                g_dbg.cands[out] = g_dbg.cands[i];
+                g_dbg.prev[out] = v;
+                ++out;
+            }
+        }
+        g_dbg.cands.resize(out);
+        g_dbg.prev.resize(out);
+        g_dbg.sel = 0;
+        static const char *kNames[] = {"= valor", "mudou", "nao mudou", "diminuiu", "aumentou"};
+        g_dbg.status = std::to_string(out) + " candidatos (" + kNames[mode] + ")";
+    }
+
+    void toggleFreeze(const uint8_t *ram, uint32_t addr, ValType t)
+    {
+        for (size_t i = 0; i < g_dbg.frozenAddr.size(); ++i)
+            if (g_dbg.frozenAddr[i] == addr)
+            {
+                g_dbg.frozenAddr.erase(g_dbg.frozenAddr.begin() + static_cast<long>(i));
+                g_dbg.frozenRaw.erase(g_dbg.frozenRaw.begin() + static_cast<long>(i));
+                g_dbg.frozenType.erase(g_dbg.frozenType.begin() + static_cast<long>(i));
+                g_dbg.status = "descongelado";
+                return;
+            }
+        uint32_t raw = readRaw(ram, addr, t);
+        parseRaw(g_dbg.input, t, raw); // com valor digitado, congela nele
+        g_dbg.frozenAddr.push_back(addr);
+        g_dbg.frozenRaw.push_back(raw);
+        g_dbg.frozenType.push_back(t);
+        g_dbg.status = "congelado em " + format(raw, t);
+    }
+
+    void handleTextInput()
+    {
+        for (int ch = GetCharPressed(); ch != 0; ch = GetCharPressed())
+        {
+            if ((ch >= '0' && ch <= '9') || ch == '.' || ch == '-')
+            {
+                if (g_dbg.input.size() < 24u)
+                    g_dbg.input.push_back(static_cast<char>(ch));
+            }
+        }
+        if (IsKeyPressed(KEY_BACKSPACE) && !g_dbg.input.empty())
+            g_dbg.input.pop_back();
+    }
+}
+
+// Chamado a cada quadro do host entre BeginDrawing/EndDrawing (ps2_runtime.cpp). Devolve true se aberto.
+bool ps2DebugMenuUpdateAndDraw(uint8_t *ram)
+{
+    // congelamentos valem com o menu aberto ou fechado
+    if (ram)
+    {
+        for (size_t i = 0; i < g_dbg.frozenAddr.size(); ++i)
+            writeRaw(ram, g_dbg.frozenAddr[i], g_dbg.frozenType[i], g_dbg.frozenRaw[i]);
+        for (const Cheat &c : g_dbg.cheats)
+            if (c.frozen)
+                writeRaw(ram, c.addr, c.type, c.raw);
+    }
+    if (g_dbg.releasePending && !IsKeyDown(KEY_ENTER) && !IsKeyDown(KEY_SPACE))
+    {
+        g_dbg.releasePending = false;
+        ps2PadSetBlocked(false);
+    }
+    if (!ps2DistMode() && IsKeyPressed(KEY_F11))
+    {
+        g_dbg.open = !g_dbg.open;
+        if (g_dbg.open)
+        {
+            ps2PadSetBlocked(true);
+            if (!g_dbg.cheatsLoaded)
+                loadCheats();
+        }
+        else
+            g_dbg.releasePending = true;
+    }
+    if (!g_dbg.open || !ram)
+        return g_dbg.open;
+
+    // teclas (letras sao comandos; digitos/./-/x/a-f entram no valor)
+    if (IsKeyPressed(KEY_TAB))
+    {
+        g_dbg.tab = 1 - g_dbg.tab;
+        g_dbg.sel = 0;
+    }
+    const int listSize = g_dbg.tab == 0 ? static_cast<int>(std::min<size_t>(g_dbg.cands.size(), 14u))
+                                        : static_cast<int>(g_dbg.cheats.size());
+    if (IsKeyPressed(KEY_DOWN) && listSize > 0) g_dbg.sel = (g_dbg.sel + 1) % listSize;
+    if (IsKeyPressed(KEY_UP) && listSize > 0) g_dbg.sel = (g_dbg.sel + listSize - 1) % listSize;
+    if (g_dbg.sel >= listSize) g_dbg.sel = 0;
+
+    if (g_dbg.tab == 0)
+    {
+        if (IsKeyPressed(KEY_T))
+        {
+            g_dbg.type = static_cast<ValType>((static_cast<int>(g_dbg.type) + 1) % 4);
+            g_dbg.scanned = false;
+            g_dbg.cands.clear();
+            g_dbg.prev.clear();
+        }
+        if (IsKeyPressed(KEY_ENTER)) newScan(ram);
+        if (g_dbg.scanned)
+        {
+            if (IsKeyPressed(KEY_N)) filter(ram, 0);
+            if (IsKeyPressed(KEY_C)) filter(ram, 1);
+            if (IsKeyPressed(KEY_U)) filter(ram, 2);
+            if (IsKeyPressed(KEY_D)) filter(ram, 3);
+            if (IsKeyPressed(KEY_I)) filter(ram, 4);
+        }
+        if (listSize > 0)
+        {
+            const uint32_t addr = g_dbg.cands[static_cast<size_t>(g_dbg.sel)];
+            if (IsKeyPressed(KEY_W))
+            {
+                uint32_t raw;
+                if (parseRaw(g_dbg.input, g_dbg.type, raw)) { writeRaw(ram, addr, g_dbg.type, raw); g_dbg.status = "escrito"; }
+                else g_dbg.status = "digite o valor a escrever";
+            }
+            if (IsKeyPressed(KEY_F)) toggleFreeze(ram, addr, g_dbg.type);
+            if (IsKeyPressed(KEY_S)) saveCandidate(ram, addr);
+        }
+    }
+    else if (listSize > 0)
+    {
+        Cheat &c = g_dbg.cheats[static_cast<size_t>(g_dbg.sel)];
+        if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_F))
+        {
+            c.frozen = !c.frozen;
+            uint32_t raw;
+            if (c.frozen && parseRaw(g_dbg.input, c.type, raw))
+                c.raw = raw;
+            else if (c.frozen && c.raw == 0u)
+                c.raw = readRaw(ram, c.addr, c.type);
+            g_dbg.status = c.frozen ? "congelado: " + c.name : "solto: " + c.name;
+        }
+        if (IsKeyPressed(KEY_W))
+        {
+            uint32_t raw;
+            if (parseRaw(g_dbg.input, c.type, raw)) { writeRaw(ram, c.addr, c.type, raw); g_dbg.status = "escrito: " + c.name; }
+        }
+        if (IsKeyPressed(KEY_R)) loadCheats();
+    }
+    handleTextInput();
+
+    // desenho
+    const int sw = GetScreenWidth(), sh = GetScreenHeight();
+    const int fs = std::max(14, sh / 34);
+    const int lh = fs + 4;
+    const int bw = std::min(sw - 20, fs * 34);
+    const int bh = std::min(sh - 20, lh * 24);
+    const int bx = 10, by = 10;
+    DrawRectangle(bx, by, bw, bh, Fade(BLACK, 0.82f));
+    DrawRectangleLines(bx, by, bw, bh, Color{200, 160, 90, 255});
+    int y = by + 6;
+    auto line = [&](const std::string &text, Color col) {
+        DrawText(text.c_str(), bx + 8, y, fs, col);
+        y += lh;
+    };
+    const Color gold{200, 160, 90, 255}, dim{170, 170, 160, 255};
+    line(std::string("DEBUG   ") + (g_dbg.tab == 0 ? "[BUSCA]  trapacas" : " busca  [TRAPACAS]") + "    Tab troca   F11 fecha", gold);
+    line("Valor: " + g_dbg.input + "_", RAYWHITE);
+    if (g_dbg.tab == 0)
+    {
+        line(std::string("Tipo: ") + typeName(g_dbg.type) + "  (T troca)   Enter = nova busca (vazio = tudo)", dim);
+        line("N = valor  C = mudou  U = nao mudou  D = diminuiu  I = aumentou", dim);
