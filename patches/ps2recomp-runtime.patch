diff --git a/ps2xIOP/src/emulator/core/spu2.cpp b/ps2xIOP/src/emulator/core/spu2.cpp
new file mode 100644
index 0000000..52dc294
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/spu2.cpp
@@ -0,0 +1,608 @@
+#include "spu2.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kCoreStride = 0x400u;
+        constexpr uint32_t kGlobalVolBase = 0x1F900760u; // MVOL, EVOL, AVOL, BVOL por nucleo (passo 0x28)
+        constexpr uint32_t kIrqInfo = 0x1F9007C2u;
+
+        // Saida para o host: anel de quadros estereo (L,R). A thread de audio consome; se encher, os
+        // quadros mais antigos sao descartados para a latencia nao crescer.
+        constexpr size_t kRingFrames = 16384u;
+        std::mutex g_ringMutex;
+        std::vector<int16_t> g_ring(kRingFrames * 2u);
+        size_t g_ringRead = 0u, g_ringCount = 0u;
+
+        // Diagnostico: PS2X_SPU2_LOG=1 imprime contadores a cada 5 s de audio
+        struct Stats
+        {
+            uint64_t kon = 0, koff = 0, dmaBytes = 0, admaBytes = 0, admaCalls = 0, admaLast = 0, admaNonZero = 0, irqs = 0, dataPort = 0, endHits = 0;
+        } g_stats;
+        bool statsOn()
+        {
+            static const bool on = std::getenv("PS2X_SPU2_LOG") != nullptr;
+            return on;
+        }
+
+        constexpr int32_t kFilter0[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kFilter1[5] = {0, 0, -52, -55, -60};
+
+        int32_t clamp16(int32_t v) { return std::clamp<int32_t>(v, -32768, 32767); }
+
+        // Volume de 15 bits com sinal (bit 15 = modo sweep: sem sweep aqui, usa o maximo)
+        int32_t volume(uint16_t v)
+        {
+            if (v & 0x8000u)
+                return 0x7FFF;
+            return static_cast<int16_t>(static_cast<uint16_t>(v << 1));
+        }
+
+        // AVOL/BVOL nao tem sweep: valor com sinal de 16 bits direto (0x7FFF = maximo; o player de FMV usa 0x7FFF).
+        // Com a regra de volume(), 0x7FFF virava -2 e a entrada PCM ficava muda.
+        int32_t inputVolume(uint16_t v)
+        {
+            return v ? static_cast<int16_t>(v) : 0x7FFF;
+        }
+    }
+
+    // Saida para o host (FUNCOES.md #87). O SPU2 produz em rajadas (a cada fatia do IOP) e o ritmo medio oscila em
+    // volta de 48 kHz. Antes a falta virava silencio na hora (micro cortes) e o excesso acima de 85 ms era pulado
+    // (estalos). Agora: (1) so toca com kTarget quadros no anel e, se esvaziar, espera encher de novo (um corte
+    // maior e raro em vez de muitos pequenos); (2) reamostragem linear com razao ajustada pelo nivel do anel
+    // (ate +-2%, inaudivel) segura a latencia perto de kTarget sem cortar nem pular; (3) so pula acima de 4x kTarget.
+    size_t spu2PullOutput(int16_t *destination, size_t frames)
+    {
+        constexpr size_t kTarget = 2400u; // 50 ms
+        static bool s_buffering = true;
+        static double s_phase = 0.0;      // posicao fracionaria entre o 1o e o 2o quadro do anel
+        static uint64_t s_underruns = 0u, s_skipped = 0u, s_pulls = 0u;
+        std::lock_guard<std::mutex> lock(g_ringMutex);
+        auto frameAt = [](size_t i, int ch) { return g_ring[((g_ringRead + i) % kRingFrames) * 2u + ch]; };
+
+        if (g_ringCount > kTarget * 4u)
+        {
+            const size_t skip = g_ringCount - kTarget;
+            g_ringRead = (g_ringRead + skip) % kRingFrames;
+            g_ringCount -= skip;
+            s_skipped += skip;
+        }
+        size_t n = 0;
+        if (s_buffering && g_ringCount >= kTarget)
+            s_buffering = false;
+        if (!s_buffering)
+        {
+            const double error = (static_cast<double>(g_ringCount) - kTarget) / kTarget;
+            const double step = 1.0 + std::clamp(error * 0.02, -0.02, 0.02);
+            for (; n < frames; ++n)
+            {
+                if (g_ringCount < 2u)
+                {
+                    s_buffering = true;
+                    ++s_underruns;
+                    break;
+                }
+                const double f = s_phase;
+                for (int ch = 0; ch < 2; ++ch)
+                {
+                    const double a = frameAt(0, ch), b = frameAt(1, ch);
+                    destination[n * 2u + ch] = static_cast<int16_t>(a + (b - a) * f);
+                }
+                s_phase += step;
+                const size_t adv = static_cast<size_t>(s_phase);
+                s_phase -= static_cast<double>(adv);
+                const size_t eat = std::min(adv, g_ringCount);
+                g_ringRead = (g_ringRead + eat) % kRingFrames;
+                g_ringCount -= eat;
+            }
+        }
+        // Diagnostico sempre ligado mas raro: uma linha a cada ~10 s de audio se houve corte ou pulo
+        if (++s_pulls % 470u == 0u && (s_underruns || s_skipped))
+        {
+            std::fprintf(stderr, "[spu2] saida: %llu cortes, %llu quadros pulados (anel %zu)\n",
+                         static_cast<unsigned long long>(s_underruns), static_cast<unsigned long long>(s_skipped), g_ringCount);
+            s_underruns = s_skipped = 0u;
+        }
+        return n;
+    }
+
+    Spu2::Spu2() : m_ram(RamWords)
+    {
+        reset();
+    }
+
+    void Spu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_regs.fill(0);
+        m_cores = {};
+        m_tsa[0] = m_tsa[1] = 0;
+        m_lastCycle = 0;
+        m_started = false;
+        m_irq = false;
+        m_irqInfo = 0;
+        m_noise = 1;
+    }
+
+    uint32_t Spu2::coreReg32(int core, uint32_t off) const
+    {
+        const uint32_t base = Base + static_cast<uint32_t>(core) * kCoreStride + off;
+        return ((static_cast<uint32_t>(regAt(base)) << 16) | regAt(base + 2u)) & 0xFFFFFu;
+    }
+
+    bool Spu2::admaActive(int core) const
+    {
+        return (regAt(Base + static_cast<uint32_t>(core) * kCoreStride + 0x1B0u) & 0xFFFFu) != 0u;
+    }
+
+    uint16_t Spu2::read16(uint32_t phys)
+    {
+        if (phys == kIrqInfo)
+            return m_irqInfo;
+        if (phys >= Base + 0x760u)
+            return regAt(phys);
+        const int core = (phys - Base) >= kCoreStride ? 1 : 0;
+        const uint32_t off = (phys - Base) - static_cast<uint32_t>(core) * kCoreStride;
+        Core &c = m_cores[core];
+        if (off < 0x180u)
+        {
+            const Voice &voice = c.voices[off >> 4];
+            switch (off & 0xFu)
+            {
+            case 0xA:
+                return static_cast<uint16_t>(voice.env);
+            case 0xC:
+                return static_cast<uint16_t>(volume(regAt(phys - 0xCu)) >> 1);
+            case 0xE:
+                return static_cast<uint16_t>(volume(regAt(phys - 0xCu)) >> 1);
+            default:
+                return regAt(phys);
+            }
+        }
+        if (off >= 0x1C0u && off < 0x1C0u + 24u * 0xCu)
+        {
+            const Voice &voice = c.voices[(off - 0x1C0u) / 0xCu];
+            switch ((off - 0x1C0u) % 0xCu)
+            {
+            case 0x8:
+                return static_cast<uint16_t>((voice.nax >> 16) & 0xFu);
+            case 0xA:
+                return static_cast<uint16_t>(voice.nax);
+            default:
+                return regAt(phys);
+            }
+        }
+        switch (off)
+        {
+        case 0x340u:
+            return static_cast<uint16_t>(c.endx);
+        case 0x342u:
+            return static_cast<uint16_t>(c.endx >> 16);
+        case 0x344u:
+            // STATX: 0 ate a primeira DMA do nucleo e 0x80 depois (o mesmo do stub antigo, com o qual o
+            // LIBSD funcionava: no init ele espera STATX & 0x7FF zerar)
+            return c.dmaSeen ? 0x80u : 0u;
+        case 0x1A8u:
+            return static_cast<uint16_t>((m_tsa[core] >> 16) & 0xFu);
+        case 0x1AAu:
+            return static_cast<uint16_t>(m_tsa[core]);
+        default:
+            return regAt(phys);
+        }
+    }
+
+    void Spu2::write16(uint32_t phys, uint16_t value)
+    {
+        reg(phys) = value;
+        if (phys >= Base + 0x760u)
+            return;
+        const int core = (phys - Base) >= kCoreStride ? 1 : 0;
+        const uint32_t off = (phys - Base) - static_cast<uint32_t>(core) * kCoreStride;
+        Core &c = m_cores[core];
+        if (off < 0x180u)
+        {
+            if ((off & 0xFu) == 0xAu)
+                c.voices[off >> 4].env = value & 0x7FFF;
+            return;
+        }
+        if (off >= 0x1C0u && off < 0x1C0u + 24u * 0xCu)
+        {
+            Voice &voice = c.voices[(off - 0x1C0u) / 0xCu];
+            const uint32_t rel = (off - 0x1C0u) % 0xCu;
+            const uint32_t base = phys - rel;
+            const auto pair = [this](uint32_t at) {
+                return ((static_cast<uint32_t>(regAt(at)) << 16) | regAt(at + 2u)) & 0xFFFFFu;
+            };
+            if (rel < 4u)
+                voice.ssa = pair(base);
+            else if (rel < 8u)
+            {
+                voice.lsa = pair(base + 4u);
+                voice.lsaSet = true;
+            }
+            else
+                voice.nax = pair(base + 8u);
+            return;
+        }
+        switch (off)
+        {
+        case 0x1A0u:
+        case 0x1A2u:
+        {
+            const int first = off == 0x1A0u ? 0 : 16;
+            for (int i = 0; i < 16 && first + i < 24; ++i)
+                if (value & (1u << i))
+                {
+                    keyOn(core, first + i);
+                    ++g_stats.kon;
+                }
+            break;
+        }
+        case 0x1A4u:
+        case 0x1A6u:
+        {
+            const int first = off == 0x1A4u ? 0 : 16;
+            for (int i = 0; i < 16 && first + i < 24; ++i)
+                if ((value & (1u << i)) && c.voices[first + i].phase != Phase::Off)
+                {
+                    c.voices[first + i].phase = Phase::Release;
+                    ++g_stats.koff;
+                    c.voices[first + i].envWait = 0;
+                }
+            break;
+        }
+        case 0x1A8u:
+        case 0x1AAu:
+            m_tsa[core] = coreReg32(core, 0x1A8u);
+            break;
+        case 0x1ACu:
+            ++g_stats.dataPort;
+            checkIrq(core, m_tsa[core], 1u);
+            m_ram[m_tsa[core] & (RamWords - 1u)] = value;
+            m_tsa[core] = (m_tsa[core] + 1u) & (RamWords - 1u);
+            break;
+        case 0x19Au:
+            if ((value & 0x40u) == 0u)
+                m_irqInfo &= static_cast<uint16_t>(~(4u << core));
+            break;
+        case 0x1B0u:
+            if ((value & 0xFFFFu) == 0u)
+                c.adma.clear();
+            break;
+        case 0x340u:
+        case 0x342u:
+            c.endx = 0;
+            break;
+        default:
+            break;
+        }
+    }
+
+    void Spu2::keyOn(int core, int v)
+    {
+        Voice &voice = m_cores[core].voices[v];
+        voice.nax = voice.ssa;
+        voice.lsaSet = false;
+        voice.counter = 0;
+        voice.prev1 = voice.prev2 = 0;
+        voice.decoded.fill(0);
+        voice.phase = Phase::Attack;
+        voice.env = 0;
+        voice.envWait = 0;
+        m_cores[core].endx &= ~(1u << v);
+        decodeBlock(core, voice);
+    }
+
+    void Spu2::decodeBlock(int core, Voice &voice)
+    {
+        const uint32_t at = voice.nax & (RamWords - 1u) & ~7u;
+        checkIrq(core, at, 8u);
+        const uint16_t w0 = m_ram[at];
+        const uint32_t shift = std::min<uint32_t>(w0 & 0xFu, 12u);
+        const uint32_t filter = std::min<uint32_t>((w0 >> 4) & 0x7u, 4u);
+        voice.flags = static_cast<uint8_t>(w0 >> 8);
+        if ((voice.flags & 4u) && !voice.lsaSet)
+            voice.lsa = at;
+        voice.decoded[0] = voice.decoded[28];
+        voice.decoded[1] = voice.decoded[29];
+        voice.decoded[2] = voice.decoded[30];
+        for (int i = 0; i < 28; ++i)
+        {
+            const uint16_t word = m_ram[(at + 1u + static_cast<uint32_t>(i >> 2)) & (RamWords - 1u)];
+            const int32_t nibble = (word >> ((i & 3) * 4)) & 0xF;
+            int32_t s = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            s += (voice.prev1 * kFilter0[filter] + voice.prev2 * kFilter1[filter] + 32) >> 6;
+            s = clamp16(s);
+            voice.prev2 = voice.prev1;
+            voice.prev1 = s;
+            voice.decoded[3 + i] = static_cast<int16_t>(s);
+        }
+    }
+
+    void Spu2::tickEnvelope(int core, int v, Voice &voice)
+    {
+        const uint32_t vb = Base + static_cast<uint32_t>(core) * kCoreStride + static_cast<uint32_t>(v) * 0x10u;
+        const uint16_t adsr1 = regAt(vb + 6u), adsr2 = regAt(vb + 8u);
+        int rate = 0;
+        bool decrease = false, exponential = false;
+        switch (voice.phase)
+        {
+        case Phase::Attack:
+            rate = (adsr1 >> 8) & 0x7F;
+            exponential = (adsr1 & 0x8000u) != 0u;
+            break;
+        case Phase::Decay:
+            rate = ((adsr1 >> 4) & 0xF) * 4;
+            decrease = exponential = true;
+            break;
+        case Phase::Sustain:
+            rate = (adsr2 >> 6) & 0x7F;
+            exponential = (adsr2 & 0x8000u) != 0u;
+            decrease = (adsr2 & 0x4000u) != 0u;
+            break;
+        case Phase::Release:
+            rate = (adsr2 & 0x1F) * 4;
+            exponential = (adsr2 & 0x20u) != 0u;
+            decrease = true;
+            break;
+        case Phase::Off:
+            return;
+        }
+        if (voice.envWait > 0u)
+        {
+            --voice.envWait;
+            return;
+        }
+        const int shift = rate >> 2;
+        int32_t step = decrease ? (-8 + (rate & 3)) : (7 - (rate & 3));
+        uint32_t cycles = 1u << std::max(0, shift - 11);
+        step = static_cast<int32_t>(static_cast<uint32_t>(step) << std::max(0, 11 - shift));
+        if (exponential && !decrease && voice.env > 0x6000)
+            cycles *= 4u;
+        if (exponential && decrease)
+            step = (step * voice.env) >> 15;
+        voice.envWait = cycles - 1u;
+        voice.env = std::clamp<int32_t>(voice.env + step, 0, 0x7FFF);
+
+        if (voice.phase == Phase::Attack && voice.env >= 0x7FFF)
+            voice.phase = Phase::Decay;
+        else if (voice.phase == Phase::Decay && voice.env <= static_cast<int32_t>(((adsr1 & 0xFu) + 1u) * 0x800u))
+            voice.phase = Phase::Sustain;
+        else if (voice.phase == Phase::Release && voice.env <= 0)
+            voice.phase = Phase::Off;
+    }
+
+    int32_t Spu2::voiceSample(int core, int v)
+    {
+        Voice &voice = m_cores[core].voices[v];
+        const uint32_t vb = Base + static_cast<uint32_t>(core) * kCoreStride + static_cast<uint32_t>(v) * 0x10u;
+        const uint32_t index = voice.counter >> 12;
+        const int32_t frac = static_cast<int32_t>(voice.counter & 0xFFFu);
+        const int32_t a = voice.decoded[2 + index], b = voice.decoded[3 + index];
+        int32_t s = a + (((b - a) * frac) >> 12);
+        const uint32_t nonMask = static_cast<uint32_t>(regAt(Base + static_cast<uint32_t>(core) * kCoreStride + 0x184u)) |
+                                 (static_cast<uint32_t>(regAt(Base + static_cast<uint32_t>(core) * kCoreStride + 0x186u)) << 16);
+        if (nonMask & (1u << v))
+            s = static_cast<int16_t>(m_noise);
+
+        tickEnvelope(core, v, voice);
+        const int32_t out = (s * voice.env) >> 15;
+
+        voice.counter += std::min<uint32_t>(regAt(vb + 4u), 0x3FFFu);
+        while ((voice.counter >> 12) >= 28u && voice.phase != Phase::Off)
+        {
+            voice.counter -= 28u << 12;
+            if (voice.flags & 1u)
+            {
+                m_cores[core].endx |= 1u << v;
+                ++g_stats.endHits;
+                voice.nax = voice.lsa;
+                if ((voice.flags & 2u) == 0u)
+                {
+                    voice.phase = Phase::Off;
+                    voice.env = 0;
+                }
+            }
+            else
+                voice.nax = (voice.nax + 8u) & (RamWords - 1u);
+            decodeBlock(core, voice);
+        }
+        return out;
+    }
+
+    void Spu2::mixSample(int32_t &outL, int32_t &outR)
+    {
+        m_noise = (m_noise << 1) | (((m_noise >> 15) ^ (m_noise >> 12) ^ (m_noise >> 11) ^ (m_noise >> 10)) & 1u);
+        int32_t coreL[2] = {0, 0}, coreR[2] = {0, 0};
+        for (int core = 0; core < 2; ++core)
+        {
+            const uint32_t cb = Base + static_cast<uint32_t>(core) * kCoreStride;
+            const uint32_t mixL = regAt(cb + 0x188u) | (static_cast<uint32_t>(regAt(cb + 0x18Au)) << 16);
+            const uint32_t mixR = regAt(cb + 0x190u) | (static_cast<uint32_t>(regAt(cb + 0x192u)) << 16);
+            int32_t l = 0, r = 0;
+            for (int v = 0; v < 24; ++v)
+            {
+                if (m_cores[core].voices[v].phase == Phase::Off)
+                    continue;
+                const int32_t s = voiceSample(core, v);
+                const uint32_t vb = cb + static_cast<uint32_t>(v) * 0x10u;
+                if (mixL & (1u << v))
+                    l += (s * volume(regAt(vb))) >> 15;
+                if (mixR & (1u << v))
+                    r += (s * volume(regAt(vb + 2u))) >> 15;
+            }
+            // Entrada PCM (AutoDMA) com BVOL; volume zerado = nao configurado, toca no maximo
+            Core &c = m_cores[core];
+            if (c.adma.size() >= 2u)
+            {
+                const uint32_t gv = kGlobalVolBase + static_cast<uint32_t>(core) * 0x28u;
+                const int32_t bl = inputVolume(regAt(gv + 0xCu));
+                const int32_t br = inputVolume(regAt(gv + 0xEu));
+                l += (c.adma.front() * bl) >> 15;
+                c.adma.pop_front();
+                r += (c.adma.front() * br) >> 15;
+                c.adma.pop_front();
+            }
+            coreL[core] = l;
+            coreR[core] = r;
+        }
+        // Nucleo 0 entra no nucleo 1 (AVOL do nucleo 1); MVOL de cada nucleo na saida
+        const uint32_t gv0 = kGlobalVolBase, gv1 = kGlobalVolBase + 0x28u;
+        const auto mvol = [this](uint32_t at) { return regAt(at) ? volume(regAt(at)) : 0x7FFF; };
+        const int32_t l0 = (coreL[0] * mvol(gv0)) >> 15, r0 = (coreR[0] * mvol(gv0 + 2u)) >> 15;
+        const int32_t al = inputVolume(regAt(gv1 + 8u));
+        const int32_t ar = inputVolume(regAt(gv1 + 0xAu));
+        const int32_t l1 = coreL[1] + ((clamp16(l0) * al) >> 15), r1 = coreR[1] + ((clamp16(r0) * ar) >> 15);
+        outL = clamp16((l1 * mvol(gv1)) >> 15);
+        outR = clamp16((r1 * mvol(gv1 + 2u)) >> 15);
+    }
+
+    void Spu2::checkIrq(int core, uint32_t wordAddress, uint32_t words)
+    {
+        (void)core;
+        for (int c = 0; c < 2; ++c)
+        {
+            const uint32_t cb = Base + static_cast<uint32_t>(c) * kCoreStride;
+            if ((regAt(cb + 0x19Au) & 0x40u) == 0u)
+                continue;
+            const uint32_t irqa = coreReg32(c, 0x19Cu);
+            if (irqa >= wordAddress && irqa < wordAddress + words)
+            {
+                m_irqInfo |= static_cast<uint16_t>(4u << c);
+                ++g_stats.irqs;
+                m_irq = true;
+            }
+        }
+    }
+
+    void Spu2::dmaWrite(int core, const uint8_t *data, size_t bytes)
+    {
+        Core &c = m_cores[core];
+        c.dmaSeen = true;
+        if (admaActive(core))
+        {
+            g_stats.admaBytes += bytes;
+            ++g_stats.admaCalls;
+            g_stats.admaLast = bytes;
+            // Blocos de 0x400 bytes: 256 amostras L e depois 256 R (16 bits)
+            for (size_t block = 0; block + 0x400u <= bytes; block += 0x400u)
+            {
+                for (size_t i = 0; i < 256u; ++i)
+                {
+                    int16_t l, r;
+                    std::memcpy(&l, data + block + i * 2u, 2);
+                    std::memcpy(&r, data + block + 0x200u + i * 2u, 2);
+                    g_stats.admaNonZero += (l != 0 || r != 0) ? 1u : 0u;
+                    c.adma.push_back(l);
+                    c.adma.push_back(r);
+                }
+            }
+            while (c.adma.size() > 48000u * 2u)
+                c.adma.pop_front();
+            return;
+        }
+        const size_t words = bytes / 2u;
+        g_stats.dmaBytes += bytes;
+        checkIrq(core, m_tsa[core], static_cast<uint32_t>(words));
+        for (size_t i = 0; i < words; ++i)
+        {
+            uint16_t w;
+            std::memcpy(&w, data + i * 2u, 2);
+            m_ram[(m_tsa[core] + i) & (RamWords - 1u)] = w;
+        }
+        m_tsa[core] = static_cast<uint32_t>((m_tsa[core] + words) & (RamWords - 1u));
+    }
+
+    void Spu2::dmaRead(int core, uint8_t *data, size_t bytes)
+    {
+        m_cores[core].dmaSeen = true;
+        const size_t words = bytes / 2u;
+        for (size_t i = 0; i < words; ++i)
+        {
+            const uint16_t w = m_ram[(m_tsa[core] + i) & (RamWords - 1u)];
+            std::memcpy(data + i * 2u, &w, 2);
+        }
+        m_tsa[core] = static_cast<uint32_t>((m_tsa[core] + words) & (RamWords - 1u));
+    }
+
+    void Spu2::pushOutput(int16_t l, int16_t r)
+    {
+        m_outBatch.push_back(l);
+        m_outBatch.push_back(r);
+    }
+
+    bool Spu2::advance(uint64_t iopCycle)
+    {
+        if (!m_started)
+        {
+            m_started = true;
+            m_lastCycle = iopCycle;
+            return false;
+        }
+        if (iopCycle <= m_lastCycle)
+            return false;
+        uint64_t samples = (iopCycle - m_lastCycle) / CyclesPerSample;
+        if (samples == 0u)
+            return false;
+        m_lastCycle += samples * CyclesPerSample;
+        samples = std::min<uint64_t>(samples, 48000u); // pausa longa: descarta o atraso
+        m_outBatch.clear();
+        for (uint64_t i = 0; i < samples; ++i)
+        {
+            int32_t l = 0, r = 0;
+            mixSample(l, r);
+            pushOutput(static_cast<int16_t>(l), static_cast<int16_t>(r));
+        }
+        // Diagnostico: PS2X_SPU2_PCM=<arquivo> grava a saida (s16le estereo 48 kHz; tools/audio_report.py)
+        static std::FILE *s_pcm = []() -> std::FILE * {
+            const char *path = std::getenv("PS2X_SPU2_PCM");
+            return path ? std::fopen(path, "wb") : nullptr;
+        }();
+        if (s_pcm)
+            std::fwrite(m_outBatch.data(), sizeof(int16_t), m_outBatch.size(), s_pcm);
+        {
+            std::lock_guard<std::mutex> lock(g_ringMutex);
+            const size_t frames = m_outBatch.size() / 2u;
+            for (size_t i = 0; i < frames; ++i)
+            {
+                if (g_ringCount == kRingFrames)
+                {
+                    g_ringRead = (g_ringRead + 1u) % kRingFrames;
+                    --g_ringCount;
+                }
+                const size_t at = ((g_ringRead + g_ringCount) % kRingFrames) * 2u;
+                g_ring[at] = m_outBatch[i * 2u];
+                g_ring[at + 1u] = m_outBatch[i * 2u + 1u];
+                ++g_ringCount;
+            }
+        }
+        static uint64_t s_logged = 0u, s_total = 0u;
+        s_total += samples;
+        if (statsOn() && s_total - s_logged >= 48000u * 5u)
+        {
+            s_logged = s_total;
+            int active = 0;
+            for (const Core &c : m_cores)
+                for (const Voice &v : c.voices)
+                    active += v.phase != Phase::Off ? 1 : 0;
+            std::fprintf(stderr,
+                         "[spu2] t=%llus kon=%llu koff=%llu ativas=%d end=%llu dma=%llu adma=%llu(%llux, ultimo %llu, naozero %llu) data=%llu irq=%llu attr=%04x/%04x admas=%04x/%04x mvol=%04x/%04x irqa=%05x\n",
+                         static_cast<unsigned long long>(s_total / 48000u), static_cast<unsigned long long>(g_stats.kon),
+                         static_cast<unsigned long long>(g_stats.koff), active, static_cast<unsigned long long>(g_stats.endHits),
+                         static_cast<unsigned long long>(g_stats.dmaBytes), static_cast<unsigned long long>(g_stats.admaBytes), static_cast<unsigned long long>(g_stats.admaCalls), static_cast<unsigned long long>(g_stats.admaLast), static_cast<unsigned long long>(g_stats.admaNonZero),
+                         static_cast<unsigned long long>(g_stats.dataPort), static_cast<unsigned long long>(g_stats.irqs),
+                         regAt(Base + 0x19Au), regAt(Base + 0x59Au), regAt(Base + 0x1B0u), regAt(Base + 0x5B0u),
+                         regAt(kGlobalVolBase), regAt(kGlobalVolBase + 0x28u), coreReg32(0, 0x19Cu));
+        }
+        const bool irq = m_irq;
+        m_irq = false;
+        return irq;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/spu2.h b/ps2xIOP/src/emulator/core/spu2.h
new file mode 100644
index 0000000..115557e
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/spu2.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // SPU2 (FUNCOES.md #81): 2 MB de RAM de som, 2 nucleos x 24 vozes ADPCM com ADSR, entrada AutoDMA
+    // (PCM de streams/videos), ENDX, IRQ por endereco e saida estereo 48 kHz para o host (spu2PullOutput).
+    // Sem reverb, modulacao de pitch nem sweep de volume (volumes em sweep ficam no ultimo valor fixo).
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t Base = 0x1F900000u;
+        static constexpr uint32_t End = 0x1F900800u;
+        static constexpr uint32_t RamWords = 1024u * 1024u; // 2 MB em palavras de 16 bits
+        static constexpr uint32_t CyclesPerSample = 768u;     // 36,864 MHz / 48 kHz
+
+        Spu2();
+        void reset();
+
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // DMA dos canais 4 (nucleo 0) e 7 (nucleo 1). Com ADMAS ligado vai para a entrada PCM do nucleo.
+        void dmaWrite(int core, const uint8_t *data, size_t bytes);
+        void dmaRead(int core, uint8_t *data, size_t bytes);
+        [[nodiscard]] bool admaActive(int core) const;
+
+        // Avanca ate o ciclo do IOP dado; true se alguma IRQ do SPU2 (linha 9) disparou.
+        bool advance(uint64_t iopCycle);
+
+    private:
+        enum class Phase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release
+        };
+
+        struct Voice
+        {
+            uint32_t ssa = 0, lsa = 0, nax = 0;
+            bool lsaSet = false;
+            uint32_t counter = 0;
+            std::array<int16_t, 31> decoded{}; // 3 de historia + 28 do bloco atual
+            int32_t prev1 = 0, prev2 = 0;
+            uint8_t flags = 0;
+            Phase phase = Phase::Off;
+            int32_t env = 0;
+            uint32_t envWait = 0;
+            int32_t lastOut = 0;
+        };
+
+        struct Core
+        {
+            std::array<Voice, 24> voices{};
+            uint32_t endx = 0;
+            std::deque<int32_t> adma; // pares L,R
+            bool dmaSeen = false;
+        };
+
+        uint16_t &reg(uint32_t phys) { return m_regs[(phys - Base) >> 1]; }
+        [[nodiscard]] uint16_t regAt(uint32_t phys) const { return m_regs[(phys - Base) >> 1]; }
+        [[nodiscard]] uint32_t coreReg32(int core, uint32_t off) const;
+        void keyOn(int core, int v);
+        void decodeBlock(int core, Voice &voice);
+        void tickEnvelope(int core, int v, Voice &voice);
+        [[nodiscard]] int32_t voiceSample(int core, int v);
+        void mixSample(int32_t &outL, int32_t &outR);
+        void checkIrq(int core, uint32_t wordAddress, uint32_t words);
+        void pushOutput(int16_t l, int16_t r);
+
+        std::vector<uint16_t> m_ram;
+        std::array<uint16_t, 0x400> m_regs{};
+        std::array<Core, 2> m_cores{};
+        uint32_t m_tsa[2] = {0, 0};
+        uint64_t m_lastCycle = 0;
+        bool m_started = false;
+        bool m_irq = false;
+        uint16_t m_irqInfo = 0;
+        uint32_t m_noise = 1;
+        std::vector<int16_t> m_outBatch;
+    };
+
+    // Consumido pela thread de audio do host: copia ate `frames` amostras estereo (int16 L,R); devolve quantas.
+    size_t spu2PullOutput(int16_t *destination, size_t frames);
+}
