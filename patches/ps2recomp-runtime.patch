+    Bridge *g_bridge = nullptr;
+
+    // Submissao assincrona (FUNCOES.md #70): o parse do fluxo GIF pelo paraLLEl-GS saiu da thread do jogo.
+    // gifTransfer so copia o pacote para a fila; a thread "PGS-Submit" entrega na ordem. present/readTransfer
+    // esvaziam a fila antes. PS2X_GS_ASYNC=0 volta ao sincrono.
+    struct Packet
+    {
+        uint32_t path;
+        std::vector<uint8_t> data;
+    };
