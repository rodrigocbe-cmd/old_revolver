+    // ---- lower ----------------------------------------------------------------------------------
+    template <uint32_t U, uint32_t L>
+    static inline void lower(VU1Interpreter &vu, Env &env)
+    {
+        constexpr uint32_t opHi = (L >> 25) & 0x7Fu;
+        VU1State &s = vu.m_state;
+        if constexpr (L == 0x00000000u || L == 0x8000033Cu)
+        {
+            return; // NOP
+        }
+        else if constexpr (opHi == 0x00u) // LQ
+        {
+            constexpr uint8_t it = static_cast<uint8_t>((L >> 16) & 0x1Fu);
+            constexpr uint8_t is = static_cast<uint8_t>((L >> 11) & 0xFu);
+            constexpr uint8_t dest = static_cast<uint8_t>((L >> 21) & 0xFu);
+            constexpr int16_t imm = static_cast<int16_t>(static_cast<int32_t>(L << 21) >> 21);
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(s.vi[is] + imm)) * 16u;
+            addr &= (env.dataSize - 1u);
+            if (addr + 16u <= env.dataSize)
+            {
+                float tmp[4];
+                std::memcpy(tmp, env.data + addr, 16);
+                plainStore(s.vf[it], tmp, dest);
+            }
+        }
+        else if constexpr (opHi == 0x08u || opHi == 0x09u) // IADDIU / ISUBIU
+        {
+            constexpr uint8_t it = static_cast<uint8_t>((L >> 16) & 0xFu);
+            constexpr uint8_t is = static_cast<uint8_t>((L >> 11) & 0xFu);
+            constexpr int16_t imm = static_cast<int16_t>(static_cast<int16_t>(L & 0x7FFu) | static_cast<int16_t>((L >> 10) & 0x7800u));
+            if constexpr (it != 0u)
+                s.vi[it] = opHi == 0x08u ? static_cast<int16_t>(s.vi[is] + imm) : static_cast<int16_t>(s.vi[is] - imm);
+        }
+        else if constexpr (opHi == 0x40u && ((L & 0x3Fu) == 0x30u || (L & 0x3Fu) == 0x31u || (L & 0x3Fu) == 0x34u || (L & 0x3Fu) == 0x35u))
+        {
+            constexpr uint8_t viT = static_cast<uint8_t>((L >> 16) & 0xFu);
+            constexpr uint8_t viS = static_cast<uint8_t>((L >> 11) & 0xFu);
+            constexpr uint8_t viD = static_cast<uint8_t>((L >> 6) & 0xFu);
+            constexpr uint32_t f = L & 0x3Fu;
+            if constexpr (viD != 0u)
+            {
+                if constexpr (f == 0x30u) s.vi[viD] = static_cast<int16_t>(s.vi[viS] + s.vi[viT]);
+                else if constexpr (f == 0x31u) s.vi[viD] = static_cast<int16_t>(s.vi[viS] - s.vi[viT]);
+                else if constexpr (f == 0x34u) s.vi[viD] = s.vi[viS] & s.vi[viT];
+                else s.vi[viD] = s.vi[viS] | s.vi[viT];
+            }
+        }
+        else if constexpr (opHi == 0x40u && (L & 0x3Fu) >= 0x3Cu && (((L & 3u) | ((L >> 4) & 0x7Cu)) == 0x30u))
+        {
+            // MOVE
+            constexpr uint8_t vfT = static_cast<uint8_t>((L >> 16) & 0x1Fu);
+            constexpr uint8_t vfS = static_cast<uint8_t>((L >> 11) & 0x1Fu);
+            constexpr uint8_t dest = static_cast<uint8_t>((L >> 21) & 0xFu);
+            float tmp[4];
+            std::memcpy(tmp, s.vf[vfS], 16);
+            plainStore(s.vf[vfT], tmp, dest);
+        }
+        else
+        {
+            vu.execLower(L, env.data, env.dataSize, *env.gs, env.memory, U);
+        }
+    }
+};
