+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string_view>
+
+// Disco virtual (.vdisc): a imagem do disco montada de arquivos soltos, com os mesmos setores da ISO original.
+// Texto: 1a linha "VDISC1 <setores>", depois "<lbn> <bytes> <caminho relativo ao .vdisc>" por linha.
+// Setores sem arquivo leem zero. EE (sceCdRead) e IOP (cdvd) leem a imagem por aqui quando o caminho da
+// imagem termina em .vdisc.
+namespace ps2_vdisc
+{
+    bool isVirtualDisc(const std::filesystem::path &path);
+    // Tamanho da imagem em bytes (0 se o .vdisc nao puder ser lido).
+    uint64_t sizeBytes(const std::filesystem::path &path);
+    // Le bytes da imagem; o que estiver alem do fim de um arquivo ou fora dos arquivos vem zerado.
+    bool read(const std::filesystem::path &path, uint64_t offset, void *dst, size_t size);
+    // Arquivo solto de um caminho do disco ("DIR/ARQ.EXT;1"): procura nos diretorios ISO9660 da propria imagem e
+    // devolve o arquivo da entrada que comeca no mesmo LBN. Serve quando a instalacao reorganizou as pastas e o
+    // jogo abre arquivos pelo nome (cdrom0:).
+    bool findFile(const std::filesystem::path &path, std::string_view isoPath, std::filesystem::path &hostFile);
+}
