+                {
+                    if constexpr (f == 0x30u) s.vi[viD] = static_cast<int16_t>(s.vi[viS] + s.vi[viT]);
+                    else if constexpr (f == 0x31u) s.vi[viD] = static_cast<int16_t>(s.vi[viS] - s.vi[viT]);
+                    else if constexpr (f == 0x34u) s.vi[viD] = s.vi[viS] & s.vi[viT];
+                    else s.vi[viD] = s.vi[viS] | s.vi[viT];
+                }
+            }
+            else if constexpr (f == 0x32u) // IADDI
+            {
+                constexpr int16_t imm5 = static_cast<int16_t>(static_cast<int32_t>(((L >> 6) & 0x1Fu) << 27) >> 27);
+                if constexpr (viT != 0u)
+                    s.vi[viT] = static_cast<int16_t>(s.vi[viS] + imm5);
+            }
+            else
+                static_assert(f == 0x30u, "lower nao suportado pelo VU1 estatico");
+        }
+        else if constexpr (opHi == 0x40u)
+        {
+            constexpr uint32_t sp = (L & 3u) | ((L >> 4) & 0x7Cu);
+            if constexpr (sp == 0x30u) // MOVE
+            {
+                if constexpr (vfT != 0u)
+                {
+                    float t[4];
+                    std::memcpy(t, s.vf[vfS], 16);
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x31u) // MR32
+            {
+                if constexpr (vfT != 0u)
+                {
+                    const float t[4] = {s.vf[vfS][1], s.vf[vfS][2], s.vf[vfS][3], s.vf[vfS][0]};
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x34u) // LQI
+            {
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viS]));
+                if constexpr (vfT != 0u)
+                    storeLanes(s.vf[vfT], reinterpret_cast<const float *>(c.data + a), dest);
+                if constexpr (viS != 0u)
+                    s.vi[viS] = static_cast<int16_t>(s.vi[viS] + 1);
+            }
+            else if constexpr (sp == 0x35u) // SQI
+            {
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viT]));
+                uint32_t w[4];
+                std::memcpy(w, s.vf[vfS], 16);
+                c.storeWords(a, w, dest);
+                if constexpr (viT != 0u)
+                    s.vi[viT] = static_cast<int16_t>(s.vi[viT] + 1);
+            }
+            else if constexpr (sp == 0x36u) // LQD
+            {
+                if constexpr (viS != 0u)
+                    s.vi[viS] = static_cast<int16_t>(s.vi[viS] - 1);
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viS]));
+                if constexpr (vfT != 0u)
+                    storeLanes(s.vf[vfT], reinterpret_cast<const float *>(c.data + a), dest);
+            }
+            else if constexpr (sp == 0x37u) // SQD
+            {
+                if constexpr (viT != 0u)
+                    s.vi[viT] = static_cast<int16_t>(s.vi[viT] - 1);
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viT]));
+                uint32_t w[4];
+                std::memcpy(w, s.vf[vfS], 16);
+                c.storeWords(a, w, dest);
+            }
+            else if constexpr (sp == 0x38u || sp == 0x39u || sp == 0x3Au) // DIV / SQRT / RSQRT
+            {
+                constexpr uint32_t fsf = (L >> 21) & 3u;
+                constexpr uint32_t ftf = (L >> 23) & 3u;
+                uint32_t di = 0u;
+                float result;
+                uint32_t latency = 7u;
+                if constexpr (sp == 0x38u)
+                {
+                    const float num = vuNormalizeOperandFast(s.vf[vfS][fsf]);
+                    const float den = vuNormalizeOperandFast(s.vf[vfT][ftf]);
+                    if (den == 0.0f)
+                    {
+                        di = num == 0.0f ? 0x10u : 0x20u;
+                        result = std::signbit(num) != std::signbit(den) ? -std::numeric_limits<float>::max()
+                                                                        : std::numeric_limits<float>::max();
+                    }
+                    else
+                        result = num / den;
+                    result = normResNoFlags(result);
+                }
+                else if constexpr (sp == 0x39u)
+                {
+                    const float val = vuNormalizeOperandFast(s.vf[vfT][ftf]);
+                    result = std::sqrt(std::fabs(val));
+                    di = val < 0.0f ? 0x10u : 0u;
+                }
+                else
+                {
+                    latency = 13u;
+                    const float num = vuNormalizeOperandFast(s.vf[vfS][fsf]);
+                    const float rad = vuNormalizeOperandFast(s.vf[vfT][ftf]);
+                    const float den = std::sqrt(std::fabs(rad));
+                    di = rad < 0.0f ? 0x10u : 0u;
+                    if (den != 0.0f)
+                        result = num / den;
+                    else
+                    {
+                        di = num == 0.0f ? 0x10u : 0x20u;
+                        result = std::signbit(num) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max();
+                    }
+                    result = normResNoFlags(result);
+                }
+                // um DIV pronto e aplicado antes de ser substituido (o interpretador o aplicou na fronteira)
+                c.commitTo(c.cyc);
+                c.fdivPending = true;
+                c.fdivReady = c.cyc + latency;
+                c.fdivValue = normResNoFlags(result);
+                c.fdivDi = di & 0x30u;
+            }
+            else if constexpr (sp == 0x3Bu || sp == 0x7Bu) // WAITQ / WAITP (a espera ja foi feita)
+            {
+            }
+            else if constexpr (sp == 0x3Cu) // MTIR
+            {
+                constexpr uint32_t comp = (L >> 21) & 3u;
+                uint32_t fval;
+                std::memcpy(&fval, &s.vf[vfS][comp], 4);
+                if constexpr (viT != 0u)
+                    s.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(fval & 0xFFFFu));
+            }
+            else if constexpr (sp == 0x3Du) // MFIR
+            {
+                if constexpr (vfT != 0u)
+                {
+                    const int32_t v = static_cast<int32_t>(static_cast<int16_t>(s.vi[viS] & 0xFFFF));
+                    float t[4];
+                    std::memcpy(&t[0], &v, 4);
+                    t[1] = t[2] = t[3] = t[0];
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x3Eu) // ILWR
+            {
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viS]));
+                uint32_t v;
+                std::memcpy(&v, c.data + a + laneIndexFromDest(dest) * 4u, 4);
+                if constexpr (viT != 0u)
+                {
+                    s.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(v & 0xFFFFu));
+                    c.viReady[viT] = c.cyc + 4u;
+                }
+            }
+            else if constexpr (sp == 0x3Fu) // ISWR
+            {
+                const uint32_t a = c.addr(static_cast<uint16_t>(s.vi[viS]));
+                const uint32_t v = static_cast<uint32_t>(static_cast<uint16_t>(s.vi[viT] & 0xFFFF));
+                const uint32_t w[4] = {v, v, v, v};
+                c.storeWords(a, w, dest);
+            }
+            else if constexpr (sp == 0x40u) // RNEXT
+            {
+                const uint32_t x = (s.r >> 4) & 1u;
+                const uint32_t y = (s.r >> 22) & 1u;
+                s.r = ((s.r << 1) ^ x ^ y) & 0x007FFFFFu;
+                s.r |= 0x3F800000u;
+                if constexpr (vfT != 0u)
+                {
+                    float v;
+                    std::memcpy(&v, &s.r, 4);
+                    const float t[4] = {v, v, v, v};
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x41u) // RGET
+            {
+                if constexpr (vfT != 0u)
+                {
+                    float v;
+                    std::memcpy(&v, &s.r, 4);
+                    const float t[4] = {v, v, v, v};
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x42u || sp == 0x43u) // RINIT / RXOR
+            {
+                constexpr uint32_t comp = (L >> 21) & 3u;
+                uint32_t bits;
+                std::memcpy(&bits, &s.vf[vfS][comp], 4);
+                if constexpr (sp == 0x42u) s.r = 0x3F800000u | (bits & 0x007FFFFFu);
+                else s.r = 0x3F800000u | ((s.r ^ bits) & 0x007FFFFFu);
+            }
+            else if constexpr (sp == 0x64u) // MFP
+            {
+                c.commitEfu();
+                if constexpr (vfT != 0u)
+                {
+                    const float t[4] = {s.p, s.p, s.p, s.p};
+                    storeLanes(s.vf[vfT], t, dest);
+                }
+            }
+            else if constexpr (sp == 0x68u) // XTOP
+            {
+                if constexpr (viT != 0u) s.vi[viT] = static_cast<int32_t>(s.top & 0x3FFu);
+            }
+            else if constexpr (sp == 0x69u) // XITOP
+            {
+                if constexpr (viT != 0u) s.vi[viT] = static_cast<int32_t>(s.itop & 0x3FFu);
+            }
+            else if constexpr (sp == 0x6Cu) // XGKICK (PATH1 livre: xgkickWait antes do par)
+            {
+                c.vu.m_cycle = c.cyc;
+                c.vu.startXgkick(static_cast<uint32_t>(static_cast<uint16_t>(s.vi[viS])));
+                c.kick = c.vu.m_xgkick.active;
+                c.kickBoundary = c.cyc;
+            }
+            else if constexpr (sp == 0x70u || sp == 0x71u || sp == 0x72u || sp == 0x73u || sp == 0x76u || sp == 0x77u ||
+                               sp == 0x78u || sp == 0x7Au)
+            {
+                float value;
+                uint32_t latency;
+                if constexpr (sp == 0x76u) // ESUM
+                {
+                    float sum = 0.0f;
+                    for (uint32_t k = 0; k < 4u; ++k)
+                        sum += vuNormalizeOperandFast(s.vf[vfS][k]);
+                    value = sum;
+                    latency = 12u;
+                }
+                else if constexpr (sp >= 0x70u && sp <= 0x73u)
+                {
+                    const float x = vuNormalizeOperandFast(s.vf[vfS][0]);
+                    const float y = vuNormalizeOperandFast(s.vf[vfS][1]);
+                    const float z = vuNormalizeOperandFast(s.vf[vfS][2]);
+                    const float sum = x * x + y * y + z * z;
+                    if constexpr (sp == 0x70u) { value = sum; latency = 11u; }
+                    else if constexpr (sp == 0x71u) { value = sum != 0.0f ? 1.0f / sum : sum; latency = 18u; }
+                    else if constexpr (sp == 0x72u) { value = std::sqrt(sum); latency = 18u; }
+                    else
+                    {
+                        const float len = std::sqrt(sum);
+                        value = len != 0.0f ? 1.0f / len : len;
+                        latency = 24u;
+                    }
+                }
+                else
+                {
+                    constexpr uint32_t comp = (L >> 21) & 3u;
+                    const float v = vuNormalizeOperandFast(s.vf[vfS][comp]);
+                    if constexpr (sp == 0x77u)
+                    {
+                        float r = v;
+                        if (r >= 0.0f)
+                        {
+                            r = std::sqrt(r);
+                            if (r != 0.0f)
+                                r = 1.0f / r;
+                        }
+                        value = r;
+                        latency = 18u;
+                    }
+                    else if constexpr (sp == 0x78u) { value = v >= 0.0f ? std::sqrt(v) : v; latency = 12u; }
+                    else { value = v != 0.0f ? 1.0f / v : v; latency = 12u; } // ERCPR
+                }
+                c.commitEfu();
+                for (int k = 0; k < 2; ++k)
+                {
+                    if (!c.efu[k].valid)
+                    {
+                        c.efu[k].valid = true;
+                        c.efu[k].ready = c.cyc + latency;
+                        c.efu[k].value = normResNoFlags(value);
+                        c.efuResourceReady = c.cyc + latency - 1u;
+                        break;
+                    }
+                }
+            }
+            else
+                static_assert(sp == 0x30u, "lower nao suportado pelo VU1 estatico");
+        }
+        else
+            static_assert(opHi == 0x00u, "lower nao suportado pelo VU1 estatico");
+    }
+};
