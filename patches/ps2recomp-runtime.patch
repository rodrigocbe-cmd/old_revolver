+        return 0x10009000u; // VIF1
+    if (mfd == 3u)
+        return 0x1000A000u; // GIF
+    return 0u;
+}
+
+uint32_t PS2Memory::mfifoWrap(uint32_t address)
+{
+    const auto rbsrIt = m_ioRegisters.find(0x1000E040u); // D_RBSR
+    const auto rborIt = m_ioRegisters.find(0x1000E050u); // D_RBOR
+    const uint32_t rbsr = (rbsrIt == m_ioRegisters.end()) ? 0u : (rbsrIt->second & 0x7FFFFFF0u);
+    const uint32_t rbor = (rborIt == m_ioRegisters.end()) ? 0u : (rborIt->second & 0x7FFFFFF0u);
+    return rbor + (address & rbsr);
+}
