@@ -0,0 +1,27 @@
+#ifndef PS2_MPEG_OPTIONS_H
+#define PS2_MPEG_OPTIONS_H
+
+namespace ps2_stubs
+{
+    // When enabled, the sceMpegGetPicture HLE returns -1 immediately if no decoded frame is ready
+    // (and the stream has not ended) instead of suspending the calling EE thread. Games whose frame
+    // loop must keep running to drain their own audio/data rings (e.g. they call GetPicture before
+    // feeding the SPU2) otherwise deadlock: the demux thread waits for ring space that only the
+    // suspended frame loop frees. Game overrides opt in; the default keeps the blocking behaviour.
+    void setMpegGetPictureNonBlocking(bool enabled);
+    bool mpegGetPictureNonBlocking();
+
+    // When enabled, sceMpegDemuxPss parks the calling EE thread while the decoded-picture queue is
+    // full and retries once GetPicture drains a frame, instead of returning 0 bytes consumed. Needed
+    // by games whose demux thread ignores the return value (the data would otherwise be dropped).
+    void setMpegDemuxBlockOnBackpressure(bool enabled);
+    bool mpegDemuxBlockOnBackpressure();
+
+    // When enabled, sceMpegIsEnd treats a demuxed MPEG program end code (0x000001B9) as producer EOF.
+    // Games that read the .PSS with plain sceCdRead/sceRead and feed sceMpegDemuxPss never hit the
+    // sceCdSt EOF the HLE otherwise waits for, so IsEnd would never report the end.
+    void setMpegProgramEndIsEof(bool enabled);
+    bool mpegProgramEndIsEof();
+}
+
+#endif // PS2_MPEG_OPTIONS_H
