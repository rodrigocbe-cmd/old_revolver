+uint32_t PS2Memory::mfifoDrainChannel()
+{
+    const auto it = m_ioRegisters.find(0x1000E000u); // D_CTRL
+    const uint32_t mfd = (it == m_ioRegisters.end()) ? 0u : ((it->second >> 2u) & 0x3u);
+    if (mfd == 2u)
+        return 0x10009000u; // VIF1
+    if (mfd == 3u)
+        return 0x1000A000u; // GIF
+    return 0u;
+}
+
+uint32_t PS2Memory::mfifoWrap(uint32_t address)
+{
+    const auto rbsrIt = m_ioRegisters.find(0x1000E040u); // D_RBSR
+    const auto rborIt = m_ioRegisters.find(0x1000E050u); // D_RBOR
+    const uint32_t rbsr = (rbsrIt == m_ioRegisters.end()) ? 0u : (rbsrIt->second & 0x7FFFFFF0u);
+    const uint32_t rbor = (rborIt == m_ioRegisters.end()) ? 0u : (rborIt->second & 0x7FFFFFF0u);
+    return rbor + (address & rbsr);
+}
+
+void PS2Memory::drainMfifo()
+{
+    const uint32_t channelBase = mfifoDrainChannel();
+    if (channelBase == 0u || !m_mfifoDrainActive)
+        return;
+
+    const auto rbsrIt = m_ioRegisters.find(0x1000E040u);
+    const uint32_t ringMask = ((rbsrIt == m_ioRegisters.end()) ? 0u : (rbsrIt->second & 0x7FFFFFF0u)) | 0xFu;
+    const uint32_t fillAddr = m_ioRegisters[0x1000D010u]; // SPR_FROM.MADR (already wrapped)
+    uint32_t chcr = m_ioRegisters[channelBase];
+    uint32_t tadr = mfifoWrap(m_ioRegisters[channelBase + 0x30u]);
+    const bool isVif = channelBase == 0x10009000u;
+    const bool transferTagData = isVif && (chcr & 0x40u) != 0u;
+    const bool tieEnabled = (chcr & 0x80u) != 0u;
+
+    std::vector<uint8_t> chainBuf;
+    auto appendQwords = [&](uint32_t address, uint32_t qwCount, bool inRing) -> bool
+    {
+        for (uint32_t i = 0; i < qwCount; ++i)
+        {
+            const uint32_t qwAddr = inRing ? mfifoWrap(address + i * 16u) : address + i * 16u;
+            const bool scratch = isScratchpad(qwAddr);
+            uint32_t phys = 0u;
+            try
+            {
+                phys = translateAddress(qwAddr);
+            }
+            catch (...)
+            {
+                return false;
+            }
+            const uint8_t *base = scratch ? m_scratchpad : m_rdram;
+            const uint32_t limit = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            if (phys + 16u > limit)
+                return false;
+            chainBuf.insert(chainBuf.end(), base + phys, base + phys + 16u);
+        }
+        return true;
+    };
+
+    bool ended = false;
+    uint32_t lastTagUpper = (chcr >> 16u) & 0xFFFFu;
+    for (int tags = 0; tags < 4096 && tadr != fillAddr; ++tags)
+    {
+        uint32_t tagPhys = 0u;
+        try
+        {
+            tagPhys = translateAddress(tadr);
+        }
+        catch (...)
+        {
+            break;
+        }
+        if (tagPhys + 16u > PS2_RAM_SIZE)
+            break;
+
+        const uint64_t tag = loadScalar<uint64_t>(m_rdram + tagPhys, 0, 16, "mfifo dma tag", tadr);
+        const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28) & 0x7u);
+        const bool irq = ((tag >> 31) & 0x1ull) != 0ull;
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0x7FFFFFF0u);
+
+        // Data that follows the tag lives in the ring: stall until the producer has written it all.
+        const bool payloadInRing = id == 1u || id == 2u || id == 7u;
+        const uint32_t needed = 16u + (payloadInRing ? tagQwc * 16u : 0u);
+        const uint32_t available = (fillAddr - tadr) & ringMask;
+        if (needed > available)
+            break;
+
+        uint32_t dataAddr = 0u;
+        uint32_t nextTadr = 0u;
+        bool endChain = false;
+        switch (id)
+        {
+        case 0: // refe
+            dataAddr = addr;
+            nextTadr = mfifoWrap(tadr + 16u);
+            endChain = true;
+            break;
+        case 1: // cnt
+            dataAddr = tadr + 16u;
+            nextTadr = mfifoWrap(tadr + 16u + tagQwc * 16u);
+            break;
+        case 2: // next
+            dataAddr = tadr + 16u;
+            nextTadr = mfifoWrap(addr);
+            break;
+        case 3: // ref
+        case 4: // refs
+            dataAddr = addr;
+            nextTadr = mfifoWrap(tadr + 16u);
+            break;
+        case 7: // end
+            dataAddr = tadr + 16u;
+            nextTadr = mfifoWrap(tadr + 16u + tagQwc * 16u);
+            endChain = true;
+            break;
+        default: // call/ret are not valid in MFIFO mode
+            std::cerr << "[MFIFO] unsupported tag id " << id << " at 0x" << std::hex << tadr << std::dec << std::endl;
+            nextTadr = tadr;
+            endChain = true;
+            break;
+        }
+
+        if (transferTagData)
+            chainBuf.insert(chainBuf.end(), m_rdram + tagPhys + 8u, m_rdram + tagPhys + 16u);
+        if (tagQwc != 0u && id <= 7u && !(id == 5u || id == 6u))
+        {
+            if (!appendQwords(dataAddr, tagQwc, payloadInRing))
+            {
+                endChain = true;
+            }
+        }
+
+        lastTagUpper = static_cast<uint32_t>((tag >> 16) & 0xFFFFu);
+        tadr = nextTadr;
+        if (endChain || (irq && tieEnabled))
+        {
+            ended = true;
+            break;
+        }
+    }
+
+    {
+        static uint32_t s_mfifoLogCount = 0u;
+        if (s_mfifoLogCount < 40u || (s_mfifoLogCount % 2000u) == 0u)
+        {
+            std::cerr << "[MFIFO] drain ch=0x" << std::hex << channelBase
+                      << " tadr0=0x" << m_ioRegisters[channelBase + 0x30u]
+                      << " tadr=0x" << tadr << " fill=0x" << fillAddr
+                      << " chcr=0x" << chcr << std::dec
+                      << " bytes=" << chainBuf.size() << " ended=" << ended << std::endl;
+        }
+        ++s_mfifoLogCount;
+    }
+    m_ioRegisters[channelBase + 0x30u] = tadr;
+    chcr = (chcr & 0x0000FFFFu) | (lastTagUpper << 16u);
+    if (ended)
+    {
+        m_mfifoDrainActive = false;
+        chcr &= ~0x100u;
+    }
+    m_ioRegisters[channelBase] = chcr;
+
+    if (!chainBuf.empty())
+    {
+        PendingTransfer pt;
+        pt.chainData = std::move(chainBuf);
+        if (isVif)
+            m_pendingVif1Transfers.push_back(std::move(pt));
+        else
+            m_pendingGifTransfers.push_back(std::move(pt));
+        processPendingTransfers();
+    }
+
+    if (ended)
+        completeDmacChannel(channelBase, isVif ? 1u : 2u);
+}
