+#pragma once
+
+#include <cstdint>
+#include <cstring>
+
+// Desempenho (FUNCOES.md #45): versao inline de VU1Interpreter::normalizeOperand, chamada para cada
+// operando de cada instrucao FMAC. O metodo fica fora de linha em outro arquivo e o compilador nao o
+// embutia. Mesma logica: denormal -> zero com sinal, Inf/NaN -> +-FLT_MAX.
+static inline float vuNormalizeOperandFast(float value)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const uint32_t exponent = bits & 0x7F800000u;
+    if (exponent == 0u)
+        bits &= 0x80000000u;
+    else if (exponent == 0x7F800000u)
+        bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
