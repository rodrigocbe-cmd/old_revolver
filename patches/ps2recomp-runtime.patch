+            AdpcmMixStereo, // AGESND (Red Dead Revolver): decodifica ADPCM 4 bits e mistura em L/R com repeticao 1/2/4
+            AdpcmMixMono,   // AGESND: idem, um canal
+        };
+        struct HleHook
+        {
+            uint32_t pc = 0;
+            HleKind kind = HleKind::AdpcmMixStereo;
+            uint32_t table = 0; // tabela de passos (endereco relocado lido do lui/addiu do proprio codigo)
+        };
+        std::vector<HleHook> hleHooks;
+
+        static bool hleEnabled()
+        {
+            static const bool enabled = []() {
+                const char *v = std::getenv("PS2X_IOP_HLE");
+                return !v || std::atoi(v) != 0;
+            }();
+            return enabled;
+        }
+
+        uint32_t hleLuiAddiu(uint32_t luiAddress) const
+        {
+            const uint32_t lui = memory.read32(luiAddress);
+            const uint32_t addiu = memory.read32(luiAddress + 4u);
+            return ((lui & 0xFFFFu) << 16) + static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(addiu & 0xFFFFu)));
+        }
+
+        void scanHleSignatures(const Module &module)
+        {
+            if (!hleEnabled())
+                return;
+            static constexpr uint32_t kStereo[] = {0x27bdfff0u, 0x0000c021u, 0x24aa0200u, 0x00806821u, 0xafb3000cu, 0xafb20008u,
+                                                   0xafb10004u, 0xafb00000u, 0x80e20002u, 0x84eb0000u, 0x8fae0020u, 0x8faf0024u};
+            static constexpr uint32_t kMono[] = {0x00006821u, 0x00805821u, 0x80e20002u, 0x84ea0000u, 0x8fb80010u, 0x18c00033u,
+                                                 0x000218c0u};
+            auto matches = [this](uint32_t address, const uint32_t *words, size_t count) {
+                for (size_t i = 0; i < count; ++i)
+                    if (memory.read32(address + static_cast<uint32_t>(i) * 4u) != words[i])
+                        return false;
+                return true;
+            };
+            for (uint32_t a = module.base; a + 64u <= module.base + module.size; a += 4u)
+            {
+                if (matches(a, kStereo, std::size(kStereo)))
+                {
+                    hleHooks.push_back({a, HleKind::AdpcmMixStereo, hleLuiAddiu(a + 0x44u)});
+                    std::ostringstream out;
+                    out << "[IOP] HLE AdpcmMixStereo em 0x" << std::hex << a << " (" << module.name << ") tabela=0x"
+                        << hleHooks.back().table;
+                    log(LogLevel::Info, out.str());
+                }
+                else if (matches(a, kMono, std::size(kMono)))
+                {
+                    hleHooks.push_back({a, HleKind::AdpcmMixMono, hleLuiAddiu(a + 0x1Cu)});
+                    std::ostringstream out;
+                    out << "[IOP] HLE AdpcmMixMono em 0x" << std::hex << a << " (" << module.name << ") tabela=0x"
+                        << hleHooks.back().table;
+                    log(LogLevel::Info, out.str());
+                }
+            }
+        }
+
+        // Soma com saturacao em 16 bits sobre a amostra existente (lh/addu/sh com clamp da rotina original)
+        void hleMixSample(uint32_t address, int32_t value)
+        {
+            int32_t v = static_cast<int32_t>(static_cast<int16_t>(memory.read16(address))) + value;
+            if (v > 0x7FFF)
+                v = 0x7FFF;
+            else if (v < -0x8000)
+                v = -0x8000;
+            memory.write16(address, static_cast<uint16_t>(v));
+        }
+
+        // Passo do decodificador: escolhe o nibble pela paridade do contador, atualiza preditor e indice.
+        void hleAdpcmStep(int32_t count, uint32_t &src, int32_t &byte, int32_t &idx8, int32_t &pred, uint32_t table)
+        {
+            int32_t nib;
+            if ((count & 1) == 0)
+            {
+                const int32_t b = static_cast<int32_t>(static_cast<uint32_t>(memory.read8(src)) << 24);
+                ++src;
+                byte = b >> 24;
+                nib = b >> 28;
+            }
+            else
+                nib = byte & 0xF;
+            const int32_t mag = nib & 7;
+            const uint32_t off = static_cast<uint32_t>(idx8 + mag) << 2;
+            const int32_t diff = memory.read16(table + off);
+            idx8 = memory.read16(table + off + 2u);
+            if (nib == mag)
+            {
+                pred += diff;
+                if (pred > 0x7FFF)
+                    pred = 0x7FFF;
+            }
+            else
+            {
+                pred -= diff;
+                if (pred < -0x8000)
+                    pred = -0x8000;
+            }
+        }
+
+        static int32_t hleScale(int32_t pred, int32_t volume)
+        {
+            // mult + mflo (32 bits baixos) + sra 7
+            const uint32_t lo = static_cast<uint32_t>(static_cast<int64_t>(pred) * static_cast<int64_t>(volume));
+            return static_cast<int32_t>(lo) >> 7;
+        }
+
+        bool tryHle(CpuState &cpu)
+        {
+            const HleHook *hook = nullptr;
+            for (const HleHook &h : hleHooks)
+                if (h.pc == cpu.pc)
+                {
+                    hook = &h;
+                    break;
+                }
+            if (!hook)
+                return false;
+            if (cpu.pendingLoad)
+            {
+                if (cpu.pendingLoadReg != 0u)
+                    cpu.gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+                cpu.pendingLoad = false;
+            }
+            auto &g = cpu.gpr;
+            const uint32_t sp = g[29];
+            uint32_t src = g[4];
+            const uint32_t state = g[7];
+            int32_t count = static_cast<int32_t>(g[6]);
+            int32_t idx8 = static_cast<int32_t>(static_cast<int8_t>(memory.read8(state + 2u))) << 3;
+            int32_t pred = static_cast<int16_t>(memory.read16(state));
+            int32_t byte = 0;
+            const int32_t samples = count > 0 ? count : 0;
+            if (hook->kind == HleKind::AdpcmMixStereo)
+            {
+                uint32_t outL = g[5];
+                uint32_t outR = g[5] + 0x200u;
+                const uint32_t quad = memory.read32(sp + 0x10u);
+                const uint32_t pairFlag = memory.read32(sp + 0x14u);
+                const uint32_t skipRight = memory.read32(sp + 0x18u);
+                const int32_t volL = static_cast<int32_t>(memory.read32(sp + 0x1Cu));
+                const int32_t volR = static_cast<int32_t>(memory.read32(sp + 0x20u));
+                const int writes = quad != 0u ? 4 : (pairFlag != 0u ? 2 : 1);
+                for (; count > 0; --count)
+                {
+                    hleAdpcmStep(count, src, byte, idx8, pred, hook->table);
+                    const int32_t l = hleScale(pred, volL);
+                    for (int w = 0; w < writes; ++w, outL += 2u)
+                        hleMixSample(outL, l);
+                    if (skipRight == 0u)
+                    {
+                        const int32_t r = hleScale(pred, volR);
+                        for (int w = 0; w < writes; ++w, outR += 2u)
+                            hleMixSample(outR, r);
+                    }
+                }
+            }
+            else
+            {
+                uint32_t out = g[5];
+                const int32_t vol = static_cast<int32_t>(memory.read32(sp + 0x10u));
+                for (; count > 0; --count, out += 2u)
+                {
+                    hleAdpcmStep(count, src, byte, idx8, pred, hook->table);
+                    hleMixSample(out, hleScale(pred, vol));
+                }
+            }
+            const int32_t index = idx8 >> 3;
+            memory.write16(state, static_cast<uint16_t>(pred));
+            memory.write8(state + 2u, static_cast<uint8_t>(index));
+            g[2] = static_cast<uint32_t>(index);
+            cpu.pc = g[31];
+            cpu.branchPending = false;
+            // custo aproximado da rotina interpretada, para o relogio do IOP seguir parecido
+            totalCycles += static_cast<uint64_t>(samples) * 40u;
+            return true;
+        }
+
         IopMemory memory;
         IopSysmem sysmem;
         IopKernel kernel;
