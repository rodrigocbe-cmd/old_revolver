+                constexpr uint32_t bc = op & 3u;
+                if constexpr (op <= 0x03u)
+                {
+                    for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] + vt[bc];
+                    fmacStore(vu, vd, result, dest);
+                }
+                else if constexpr (op <= 0x07u)
+                {
+                    for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] - vt[bc];
+                    fmacStore(vu, vd, result, dest);
+                }
+                else if constexpr (op <= 0x0Bu)
+                {
+                    for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] + vs[c] * vt[bc];
+                    fmacStore(vu, vd, result, dest);
+                }
+                else if constexpr (op <= 0x0Fu)
+                {
+                    for (uint32_t c = 0; c < 4u; ++c) result[c] = acc[c] - vs[c] * vt[bc];
