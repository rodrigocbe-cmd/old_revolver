+                else if constexpr (op == 0x1Cu) { for (uint32_t c = 0; c < 4u; ++c) result[c] = vs[c] * q; fmacStore(vu, vd, result, dest); }
+                else if constexpr (op == 0x1Du) { for (uint32_t c = 0; c < 4u; ++c) result[c] = (vs[c] > i) ? vs[c] : i; plainStore(vd, result, dest); }
