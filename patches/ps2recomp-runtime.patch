+                         const R5900Context *ctx)
+{
+    static std::mutex s_mutex;
+    static std::unordered_map<uint32_t, uint32_t> s_perPc;
+    static uint32_t s_total = 0u;
+    std::lock_guard<std::mutex> lock(s_mutex);
+    // PS2X_WRITE_WATCH_MAX=<por PC>[:<total>] (padrao 16:4000)
+    static const std::pair<uint32_t, uint32_t> s_limits = []()
+    {
+        uint32_t perPc = 16u, total = 4000u;
+        if (const char *env = std::getenv("PS2X_WRITE_WATCH_MAX"))
+        {
+            char *end = nullptr;
+            perPc = static_cast<uint32_t>(std::strtoul(env, &end, 0));
+            if (end && *end == ':')
