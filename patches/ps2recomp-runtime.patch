diff --git a/ps2xRuntime/src/lib/ps2_virtual_disc.cpp b/ps2xRuntime/src/lib/ps2_virtual_disc.cpp
new file mode 100644
index 0000000..a0e6f33
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_virtual_disc.cpp
@@ -0,0 +1,232 @@
+#include "ps2_virtual_disc.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace ps2_vdisc
+{
+    namespace
+    {
+        constexpr uint64_t kSector = 2048u;
+
+        struct Entry
+        {
+            uint64_t lbn = 0;
+            uint64_t bytes = 0;
+            std::filesystem::path host;
+            std::FILE *stream = nullptr;
+        };
+
+        struct Disc
+        {
+            std::filesystem::path path;
+            uint64_t sectors = 0;
+            std::vector<Entry> entries; // ordenadas por lbn
+            bool ok = false;
+        };
+
+        std::mutex g_mutex;
+        std::unique_ptr<Disc> g_disc;
+
+        Disc *load(const std::filesystem::path &path)
+        {
+            if (g_disc && g_disc->path == path)
+                return g_disc->ok ? g_disc.get() : nullptr;
+            if (g_disc)
+                for (Entry &e : g_disc->entries)
+                    if (e.stream)
+                        std::fclose(e.stream);
+            g_disc = std::make_unique<Disc>();
+            g_disc->path = path;
+            std::ifstream in(path);
+            std::string line, magic;
+            if (!std::getline(in, line))
+                return nullptr;
+            std::istringstream head(line);
+            if (!(head >> magic >> g_disc->sectors) || magic != "VDISC1")
+                return nullptr;
+            const std::filesystem::path base = path.parent_path();
+            while (std::getline(in, line))
+            {
+                std::istringstream ls(line);
+                Entry e;
+                if (!(ls >> e.lbn >> e.bytes))
+                    continue;
+                std::string rel;
+                std::getline(ls >> std::ws, rel);
+                if (!rel.empty() && rel.back() == '\r')
+                    rel.pop_back();
+                e.host = base / std::filesystem::u8path(rel);
+                g_disc->entries.push_back(std::move(e));
+            }
+            std::sort(g_disc->entries.begin(), g_disc->entries.end(),
+                      [](const Entry &a, const Entry &b) { return a.lbn < b.lbn; });
+            g_disc->ok = g_disc->sectors != 0u;
+            return g_disc->ok ? g_disc.get() : nullptr;
+        }
+
+        bool readEntry(Entry &e, uint64_t offset, uint8_t *dst, size_t size)
+        {
+            std::memset(dst, 0, size);
+            if (offset >= e.bytes)
+                return true;
+            if (!e.stream)
+            {
+#if defined(_WIN32)
+                e.stream = ::_wfopen(e.host.c_str(), L"rb");
+#else
+                e.stream = std::fopen(e.host.string().c_str(), "rb");
+#endif
+                if (!e.stream)
+                    return false;
+            }
+            const size_t want = static_cast<size_t>(std::min<uint64_t>(size, e.bytes - offset));
+#if defined(_WIN32)
+            if (_fseeki64(e.stream, static_cast<int64_t>(offset), SEEK_SET) != 0)
+#else
+            if (fseeko(e.stream, static_cast<off_t>(offset), SEEK_SET) != 0)
+#endif
+                return false;
+            return std::fread(dst, 1u, want, e.stream) == want;
+        }
+    }
+
+    bool isVirtualDisc(const std::filesystem::path &path)
+    {
+        std::string ext = path.extension().string();
+        std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        return ext == ".vdisc";
+    }
+
+    uint64_t sizeBytes(const std::filesystem::path &path)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        const Disc *disc = load(path);
+        return disc ? disc->sectors * kSector : 0u;
+    }
+
+    bool read(const std::filesystem::path &path, uint64_t offset, void *dstVoid, size_t size)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        Disc *disc = load(path);
+        if (!disc)
+            return false;
+        uint8_t *dst = static_cast<uint8_t *>(dstVoid);
+        while (size > 0u)
+        {
+            const uint64_t sector = offset / kSector;
+            // primeira entrada que comeca depois do setor; a anterior pode conte-lo
+            auto it = std::upper_bound(disc->entries.begin(), disc->entries.end(), sector,
+                                       [](uint64_t s, const Entry &e) { return s < e.lbn; });
+            size_t chunk = size;
+            bool done = false;
+            if (it != disc->entries.begin())
+            {
+                Entry &e = *(it - 1);
+                const uint64_t span = ((e.bytes + kSector - 1u) / kSector) * kSector;
+                const uint64_t rel = offset - e.lbn * kSector;
+                if (rel < span)
+                {
+                    chunk = static_cast<size_t>(std::min<uint64_t>(size, span - rel));
+                    if (!readEntry(e, rel, dst, chunk))
+                        return false;
+                    done = true;
+                }
+            }
+            if (!done)
+            {
+                if (it != disc->entries.end())
+                    chunk = static_cast<size_t>(std::min<uint64_t>(size, it->lbn * kSector - offset));
+                std::memset(dst, 0, chunk);
+            }
+            dst += chunk;
+            offset += chunk;
+            size -= chunk;
+        }
+        return true;
+    }
+
+    bool findFile(const std::filesystem::path &path, std::string_view isoPath, std::filesystem::path &hostFile)
+    {
+        auto upper = [](std::string v) {
+            std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+            return v;
+        };
+        std::vector<std::string> parts;
+        std::string cur;
+        for (char c : isoPath)
+        {
+            if (c == '/' || c == '\\')
+            {
+                if (!cur.empty())
+                    parts.push_back(upper(cur));
+                cur.clear();
+            }
+            else
+                cur.push_back(c);
+        }
+        if (!cur.empty())
+            parts.push_back(upper(cur));
+        if (parts.empty())
+            return false;
+        if (const size_t semi = parts.back().find(';'); semi != std::string::npos)
+            parts.back().resize(semi);
+
+        uint8_t pvd[kSector];
+        if (!read(path, 16u * kSector, pvd, sizeof(pvd)) || pvd[0] != 1u || std::memcmp(pvd + 1, "CD001", 5) != 0)
+            return false;
+        auto le32 = [](const uint8_t *p) { return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24; };
+        uint32_t lbn = le32(pvd + 156 + 2), size = le32(pvd + 156 + 10);
+        for (size_t level = 0; level < parts.size(); ++level)
+        {
+            if (size == 0u || size > 16u * 1024u * 1024u)
+                return false;
+            std::vector<uint8_t> dir(size);
+            if (!read(path, uint64_t(lbn) * kSector, dir.data(), dir.size()))
+                return false;
+            bool found = false;
+            for (size_t off = 0; off < dir.size();)
+            {
+                const uint8_t len = dir[off];
+                if (len == 0u)
+                {
+                    off = (off / kSector + 1u) * kSector; // registros nao cruzam setores
+                    continue;
+                }
+                if (off + len > dir.size() || len < 34u)
+                    break;
+                const uint8_t *rec = dir.data() + off;
+                std::string name(reinterpret_cast<const char *>(rec + 33), rec[32]);
+                if (const size_t semi = name.find(';'); semi != std::string::npos)
+                    name.resize(semi);
+                if (!name.empty() && name.back() == '.')
+                    name.pop_back();
+                if (upper(name) == parts[level] && ((rec[25] & 2u) != 0u) == (level + 1u < parts.size()))
+                {
+                    lbn = le32(rec + 2), size = le32(rec + 10), found = true;
+                    break;
+                }
+                off += len;
+            }
+            if (!found)
+                return false;
+        }
+        std::lock_guard<std::mutex> lock(g_mutex);
+        const Disc *disc = load(path);
+        if (!disc)
+            return false;
+        auto it = std::lower_bound(disc->entries.begin(), disc->entries.end(), uint64_t(lbn),
+                                   [](const Entry &e, uint64_t s) { return e.lbn < s; });
+        if (it == disc->entries.end() || it->lbn != lbn || it->bytes != size)
+            return false;
+        hostFile = it->host;
+        return true;
+    }
+}
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.cpp
new file mode 100644
index 0000000..f453429
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.cpp
@@ -0,0 +1,263 @@
+#include "ps2_vu1_compiled.h"
+#include "ps2_vu1_static.h"
+
+#include "runtime/ps2_memory.h"
+#include "runtime/gs/gs_draw_stats.h"
+
+#include <cfenv>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+// Registro e despachante dos microprogramas recompilados do VU1 (FUNCOES.md #61).
+// PS2X_VU1_COMPILED=0 desliga. PS2X_VU1_COMPILED_VERIFY=<n> roda tambem o interpretador numa copia para as
+// n primeiras execucoes de cada programa e compara o estado final (VF/VI/ACC/Q/P/I/MAC/clip/status/PC e memoria de dados).
+
+namespace
+{
+    struct Program
+    {
+        uint32_t start;
+        uint32_t bytes;
+        uint64_t hash;
+        Vu1Compiled::Fn fn;
+        const char *name;
+        uint64_t checkedGeneration = UINT64_MAX;
+        bool matches = false;
+        long verified = 0; // execucoes ja comparadas com o interpretador (PS2X_VU1_COMPILED_VERIFY por programa)
+        bool isStatic = false;
+    };
+
+    std::vector<Program> &registry()
+    {
+        static std::vector<Program> programs;
+        return programs;
+    }
+
+    uint64_t hashBytes(const uint8_t *data, uint32_t bytes)
+    {
+        uint64_t hash = 1469598103934665603ull;
+        for (uint32_t i = 0; i < bytes; ++i)
+            hash = (hash ^ data[i]) * 1099511628211ull;
+        return hash;
+    }
+
+    bool compiledEnabled()
+    {
+        static const bool enabled = []() {
+            const char *v = std::getenv("PS2X_VU1_COMPILED");
+            return !v || std::atoi(v) != 0;
+        }();
+        return enabled;
+    }
+
+    long verifyBudget()
+    {
+        static long budget = []() {
+            const char *v = std::getenv("PS2X_VU1_COMPILED_VERIFY");
+            return v ? std::atol(v) : 0L;
+        }();
+        return budget;
+    }
+
+    bool staticEnabled()
+    {
+        static const bool enabled = []() {
+            const char *v = std::getenv("PS2X_VU1_STATIC");
+            return !v || std::atoi(v) != 0;
+        }();
+        return enabled;
+    }
+
+    // Programa registrado que contem `pc` e cujo codigo bate com a memoria atual do VU1. Prefere o estatico
+    // (se `allowStatic`) e, entre iguais, o maior (blocos MPG contiguos juntos pelo gerador).
+    Program *findProgram(uint32_t pc, const uint8_t *code, uint32_t codeSize, uint64_t generation, bool allowStatic = false,
+                         bool onlyStatic = false)
+    {
+        Program *best = nullptr;
+        for (Program &p : registry())
+        {
+            if ((p.isStatic && !allowStatic) || (!p.isStatic && onlyStatic))
+                continue;
+            if (pc < p.start || pc >= p.start + p.bytes || p.start + p.bytes > codeSize)
+                continue;
+            if (p.checkedGeneration != generation)
+            {
+                // hash do conteudo + destino, igual ao do PS2X_VU1_DUMP_MPG / tools/vu1_recomp.py
+                p.matches = (hashBytes(code + p.start, p.bytes) ^ (static_cast<uint64_t>(p.start) << 40)) == p.hash;
+                p.checkedGeneration = generation;
+            }
+            if (p.matches && (!best || (p.isStatic && !best->isStatic) ||
+                              (p.isStatic == best->isStatic && p.bytes > best->bytes)))
+                best = &p;
+        }
+        return best;
+    }
+}
+
+void Vu1Compiled::registerProgram(uint32_t start, uint32_t bytes, uint64_t hash, Fn fn, const char *name)
+{
+    registry().push_back(Program{start, bytes, hash, fn, name});
+}
+
+void Vu1Compiled::registerStaticProgram(uint32_t start, uint32_t bytes, uint64_t hash, Fn fn, const char *name)
+{
+    Program p{start, bytes, hash, fn, name};
+    p.isStatic = true;
+    registry().push_back(p);
+}
+
+bool Vu1Compiled::tryRun(VU1Interpreter &vu, uint8_t *code, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+                         GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    if (vu.m_unit != VU1Interpreter::Unit::VU1 || !memory || registry().empty() || !compiledEnabled() ||
+        !vu1FastFmacEnabled() || !vu1FastMathEnabled())
+        return false;
+    if (code != memory->getVU1Code())
+        return false;
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    Program *program = findProgram(vu.m_state.pc, code, codeSize, generation, staticEnabled() && S::canEnter(vu));
+    if (!program)
+        return false;
+
+    // Verificacao: copia do interpretador + memoria de dados antes de rodar
+    std::unique_ptr<VU1Interpreter> reference;
+    std::vector<uint8_t> referenceData;
+    // PS2X_VU1_COMPILED_VERIFY_EVERY=<n>: compara tambem 1 de cada n execucoes durante o jogo inteiro (o orcamento
+    // por programa acaba nos primeiros segundos; um erro raro so aparece depois). So imprime divergencias.
+    static const long s_every = []() {
+        const char *v = std::getenv("PS2X_VU1_COMPILED_VERIFY_EVERY");
+        return v ? std::atol(v) : 0L;
+    }();
+    static long s_runs = 0;
+    const bool sampled = s_every > 0 && (++s_runs % s_every) == 0;
+    const bool verify = program->verified < verifyBudget() || sampled;
+    if (verify)
+    {
+        ++program->verified;
+        reference = std::make_unique<VU1Interpreter>(vu);
+        referenceData.assign(data, data + dataSize);
+    }
+    const uint32_t startPc = vu.m_state.pc;
+    const char *startName = program->name;
+    const bool startStatic = program->isStatic;
+
+    // Prologo de run()
+    vu.m_activeVuData = data;
+    vu.m_activeVuDataSize = dataSize;
+    vu.m_activeGs = &gs;
+    vu.m_activeMemory = memory;
+    // garante o cache de decodificacao valido para esta geracao do codigo
+    (void)vu.getDecodedInstructionPairForPc(code, codeSize, memory, vu.m_state.pc);
+
+    const int previousRoundingMode = std::fegetround();
+    const bool useVuRounding = std::fesetround(FE_TOWARDZERO) == 0;
+
+    Env env{code, codeSize, data, dataSize, &gs, memory};
+    int status = kExited;
+    std::optional<S::Ctx> sctx; // contexto dos estaticos: passa de um programa estatico ao proximo sem materializar
+    uint32_t pc = vu.m_state.pc;
+    while (program)
+    {
+        if (program->isStatic)
+        {
+            if (!sctx)
+            {
+                sctx.emplace(vu, env);
+                env.staticCtx = &*sctx;
+            }
+            status = program->fn(vu, env, pc);
+            if (status != kExited)
+            {
+                sctx.reset(); // finish() ja devolveu o pendente ao interpretador
+                break;
+            }
+            pc = sctx->exitPc;
+            if (Program *next = findProgram(pc, code, codeSize, generation, true, true))
+            {
+                program = next;
+                continue;
+            }
+            S::materialize(*sctx, pc);
+            sctx.reset();
+            env.staticCtx = nullptr;
+            program = findProgram(pc, code, codeSize, generation);
+            continue;
+        }
+        status = program->fn(vu, env, vu.m_state.pc);
+        if (status != kExited)
+            break;
+        pc = vu.m_state.pc;
+        program = findProgram(pc, code, codeSize, generation, staticEnabled() && S::canEnter(vu));
+    }
+
+    if (useVuRounding && previousRoundingMode != -1)
+        std::fesetround(previousRoundingMode);
+
+    if (status == kExited)
+    {
+        // Saiu para codigo nao compilado: o interpretador continua dali
+        vu.run(code, codeSize, data, dataSize, gs, memory, maxCycles);
+    }
+    else
+    {
+        // Epilogo de run()
+        if (ps2_gs_stats::statsEnabled())
+            ps2_gs_stats::countEvent(status == kEnded ? "vu1.end.ebit" : "vu1.end.other");
+        if (status == kEnded)
+        {
+            vu.flushPipelines();
+            vu.m_state.ebit = false;
+            vu.m_state.haltAfterDelaySlot = false;
+            vu.m_pendingHaltD = false;
+            vu.m_pendingHaltT = false;
+        }
+        vu.m_state.cycles = vu.m_cycle;
+    }
+    if (ps2_gs_stats::statsEnabled())
+        ps2_gs_stats::countEvent(startStatic ? "vu1.static" : "vu1.compiled");
+
+    if (verify)
+    {
+        // O interpretador de referencia roda numa copia da memoria de dados; os XGKICKs dele nao vao ao GS.
+        std::vector<uint8_t> compiledData(data, data + dataSize);
+        reference->m_activeMemory = nullptr;
+        reference->m_activeGs = nullptr;
+        reference->run(code, codeSize, referenceData.data(), dataSize, gs, nullptr, maxCycles);
+        const VU1State &a = vu.m_state;
+        const VU1State &b = reference->m_state;
+        bool same = std::memcmp(a.vf, b.vf, sizeof(a.vf)) == 0 && std::memcmp(a.vi, b.vi, sizeof(a.vi)) == 0 &&
+                    std::memcmp(a.acc, b.acc, sizeof(a.acc)) == 0 && a.q == b.q && a.p == b.p && a.i == b.i &&
+                    a.mac == b.mac && a.clip == b.clip && a.status == b.status && a.pc == b.pc &&
+                    std::memcmp(compiledData.data(), referenceData.data(), dataSize) == 0;
+        if (ps2_gs_stats::statsEnabled())
+            ps2_gs_stats::countEvent(same ? "vu1.verify.ok" : "vu1.verify.diff");
+        if (!same || program->verified <= verifyBudget())
+        std::fprintf(stderr, "[vu1-compiled] verify %s start=0x%04x prog=%s cycles=%llu/%llu%s\n", same ? "OK" : "DIFERENTE",
+                     startPc, startName, static_cast<unsigned long long>(vu.m_cycle),
+                     static_cast<unsigned long long>(reference->m_cycle), same ? "" : " <<<");
+        if (!same)
+        {
+            for (int r = 0; r < 32; ++r)
+                if (std::memcmp(a.vf[r], b.vf[r], 16) != 0)
+                    std::fprintf(stderr, "  vf%d %g,%g,%g,%g vs %g,%g,%g,%g\n", r, a.vf[r][0], a.vf[r][1], a.vf[r][2],
+                                 a.vf[r][3], b.vf[r][0], b.vf[r][1], b.vf[r][2], b.vf[r][3]);
+            for (int r = 0; r < 16; ++r)
+                if (a.vi[r] != b.vi[r])
+                    std::fprintf(stderr, "  vi%d %d vs %d\n", r, a.vi[r], b.vi[r]);
+            if (a.mac != b.mac || a.clip != b.clip || a.status != b.status || a.pc != b.pc)
+                std::fprintf(stderr, "  mac %x/%x clip %x/%x status %x/%x pc %x/%x\n", a.mac, b.mac, a.clip, b.clip,
+                             a.status, b.status, a.pc, b.pc);
+            for (uint32_t off = 0; off < dataSize; off += 16)
+                if (std::memcmp(compiledData.data() + off, referenceData.data() + off, 16) != 0)
+                {
+                    std::fprintf(stderr, "  data qw 0x%x difere\n", off / 16);
+                    break;
+                }
+        }
+    }
+    return true;
+}
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.h b/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.h
new file mode 100644
index 0000000..b87e8a3
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_compiled.h
@@ -0,0 +1,523 @@
+#pragma once
+
+// Microprogramas do VU1 recompilados (FUNCOES.md #61).
+//
+// Um gerador (tools/vu1_recomp.py do projeto) le os microprogramas enviados por VIF MPG e emite, para
+// cada programa, uma funcao com um rotulo por par de instrucoes que chama Vu1Compiled::pair<UPPER, LOWER>.
+// pair() reproduz exatamente uma iteracao de VU1Interpreter::run() no modo rapido (PS2X_VU1_FAST e
+// PS2X_VU1_FAST_MATH ligados): commit dos pipelines, espera por VI/FDIV/EFU/WAITQ/WAITP/XGKICK, bit I,
+// sombra de VF entre upper e lower, escrita atrasada de VI, regra do VI antigo nos desvios, vf0/vi0,
+// avanco de PC, D/T/E e advanceOneCycle(). As instrucoes frequentes sao resolvidas em tempo de compilacao
+// (if constexpr sobre a palavra da instrucao); as demais caem em execUpper/execLower do interpretador.
+// Assim o resultado e identico ao do interpretador e so some o custo de buscar/decodificar/despachar.
+
+#include "runtime/ps2_vu1.h"
+#include "ps2_vu1_fast.h"
+
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+class GS;
+class PS2Memory;
+
+bool vu1FastFmacEnabled();
+bool vu1FastMathEnabled();
+
+struct Vu1Compiled
+{
+    struct Env
+    {
+        uint8_t *code;
+        uint32_t codeSize;
+        uint8_t *data;
+        uint32_t dataSize;
+        GS *gs;
+        PS2Memory *memory;
+        void *staticCtx = nullptr; // S::Ctx dos programas estaticos (mantido entre programas encadeados)
+    };
+
+    // Retorno das funcoes geradas
+    static constexpr int kEnded = 0;  // programa terminou (E-bit, D/T, etc.)
+    static constexpr int kExited = 1; // saiu para um PC fora do programa: m_state.pc tem o destino
+    static constexpr int kStopped = 2; // m_stopRequested (instrucao reservada)
+
+    using Fn = int (*)(VU1Interpreter &vu, Env &env, uint32_t pc);
+
+    // Registro (feito por inicializadores estaticos do codigo gerado)
+    static void registerProgram(uint32_t start, uint32_t bytes, uint64_t hash, Fn fn, const char *name);
+    // Programas com o tempo resolvido na geracao (ps2_vu1_static.h, FUNCOES.md #67)
+    static void registerStaticProgram(uint32_t start, uint32_t bytes, uint64_t hash, Fn fn, const char *name);
+    struct S;
+
+    // Chamado por VU1Interpreter::execute(); true = programa executado (compilado e/ou interpretado).
+    static bool tryRun(VU1Interpreter &vu, uint8_t *code, uint32_t codeSize, uint8_t *data, uint32_t dataSize,
+                       GS &gs, PS2Memory *memory, uint32_t maxCycles);
+
+    // ------------------------------------------------------------------------------------------------
+    // Uma iteracao do laco de run() para o par em `pc`. Retorna -1 para continuar (nextPc preenchido)
+    // ou kEnded/kStopped.
+    template <uint32_t U, uint32_t L>
+    static inline int pair(VU1Interpreter &vu, Env &env, uint32_t pc, uint32_t &nextPc)
+    {
+        VU1State &s = vu.m_state;
+        s.pc = pc;
+        if (vu.m_cycle >= vu.m_nextCommitCycle)
+            vu.commitReadyPipelines();
+
+        const VU1Interpreter::DecodedInstructionPair &d = vu.m_decodedCodeCache[pc >> 3];
+
+        // Espera (no modo rapido VF/ACC nunca esperam; sobram VI, FDIV, EFU, WAITQ/WAITP e XGKICK)
+        uint64_t ready = readyCycle(vu, d);
+        while (ready > vu.m_cycle)
+        {
+            vu.advanceTo(ready);
+            ready = readyCycle(vu, d);
+        }
+
+        uint8_t writtenVi = 0u;
+        int32_t oldVi = 0;
+        if (const uint32_t viw = static_cast<uint32_t>(d.lowerUsage.viWrite) & 0xFFFEu)
+        {
+            writtenVi = static_cast<uint8_t>(std::countr_zero(viw));
+            oldVi = s.vi[writtenVi];
+        }
+
+        constexpr bool kIBit = (U & 0x80000000u) != 0u;
+        if constexpr (kIBit)
+        {
+            upper<U>(vu);
+            float immediate;
+            const uint32_t bits = L;
+            std::memcpy(&immediate, &bits, sizeof(immediate));
+            s.i = vuNormalizeOperandFast(immediate);
+        }
+        else if (d.upperVfShadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, s.vf[d.upperVfShadowReg], sizeof(oldVf));
+            upper<U>(vu);
+            std::memcpy(upperVf, s.vf[d.upperVfShadowReg], sizeof(upperVf));
+            std::memcpy(s.vf[d.upperVfShadowReg], oldVf, sizeof(oldVf));
+            lower<U, L>(vu, env);
+            std::memcpy(s.vf[d.upperVfShadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            upper<U>(vu);
+            lower<U, L>(vu, env);
+        }
+
+        vu.m_viBranchBackupValid = false;
+        if (writtenVi != 0u)
+        {
+            const int32_t newVi = s.vi[writtenVi];
+            s.vi[writtenVi] = oldVi;
+            const uint32_t latency = d.lowerUsage.viLatency != 0u ? d.lowerUsage.viLatency : d.lowerUsage.latency;
+            vu.queueViWrite(writtenVi, newVi, latency);
+        }
+        // markPairWrites no modo rapido: so o VI marca prontidao
+        for (uint32_t bits = static_cast<uint32_t>(d.lowerUsage.viWrite) & 0xFFFEu; bits != 0u; bits &= bits - 1u)
+            vu.m_viReady[static_cast<uint32_t>(std::countr_zero(bits))] =
+                vu.m_cycle + (d.lowerUsage.viLatency != 0u ? d.lowerUsage.viLatency : d.lowerUsage.latency);
+        if (writtenVi != 0u && d.lowerUsage.delaysNextBranchRead)
+            vu.recordViWriteForBranch(writtenVi, oldVi);
+
+        s.vf[0][0] = 0.0f;
+        s.vf[0][1] = 0.0f;
+        s.vf[0][2] = 0.0f;
+        s.vf[0][3] = 1.0f;
+        s.vi[0] = 0;
+
+        uint32_t np = pc + 8u;
+        if (np >= env.codeSize)
+            np = 0u;
+        if (s.branchPending)
+        {
+            if (s.branchDelay == 0u)
+            {
+                np = s.branchTarget & 0x3FFFu;
+                s.branchPending = false;
+            }
+            else
+                --s.branchDelay;
+        }
+        s.pc = np;
+        nextPc = np;
+
+        // Bits D/T/E (mesma ordem de run())
+        constexpr bool kE = (U & 0x40000000u) != 0u;
+        constexpr bool kD = (U & 0x10000000u) != 0u;
+        constexpr bool kT = (U & 0x08000000u) != 0u;
+        bool programEnded = false;
+        const bool dHalt = kD && s.dBitEnabled;
+        const bool tHalt = kT && s.tBitEnabled;
+        const bool haltBit = dHalt || tHalt;
+        const bool haltBranch = haltBit && d.lowerUsage.pipeline == VU1Interpreter::PipelineBranch;
+        if (s.haltAfterDelaySlot)
+        {
+            s.stoppedByD = vu.m_pendingHaltD;
+            s.stoppedByT = vu.m_pendingHaltT;
+            programEnded = true;
+        }
+        else if (s.ebit)
+            programEnded = true;
+        else if (haltBit && !haltBranch)
+        {
+            s.stoppedByD = dHalt;
+            s.stoppedByT = tHalt;
+            programEnded = true;
+        }
+        else if (kE)
+            s.ebit = true;
+        else if (haltBranch)
+        {
+            s.haltAfterDelaySlot = true;
+            vu.m_pendingHaltD = dHalt;
+            vu.m_pendingHaltT = tHalt;
+        }
+
+        advanceOneCycle(vu);
+        if (vu.m_stopRequested)
+            return kStopped;
+        return programEnded ? kEnded : -1;
+    }
+
+private:
+    static inline uint64_t readyCycle(const VU1Interpreter &vu, const VU1Interpreter::DecodedInstructionPair &d)
+    {
+        uint64_t ready = vu.m_cycle;
+        for (uint32_t bits = (static_cast<uint32_t>(d.upperUsage.viRead) | d.lowerUsage.viRead) & 0xFFFEu; bits != 0u;
+             bits &= bits - 1u)
+        {
+            const uint64_t r = vu.m_viReady[static_cast<uint32_t>(std::countr_zero(bits))];
+            if (r > ready)
+                ready = r;
+        }
+        const auto &lu = d.lowerUsage;
+        if ((lu.pipeline == VU1Interpreter::PipelineFdiv || lu.waitQ) && vu.m_fdiv.valid && vu.m_fdiv.readyCycle > ready)
+            ready = vu.m_fdiv.readyCycle;
+        if (lu.pipeline == VU1Interpreter::PipelineEfu && vu.m_efuResourceReady > ready)
+            ready = vu.m_efuResourceReady;
+        if (lu.waitP)
+            for (const auto &entry : vu.m_efu)
+                if (entry.valid && entry.readyCycle > ready)
+                    ready = entry.readyCycle;
+        if (lu.pipeline == VU1Interpreter::PipelineXgkick && vu.m_xgkick.active && vu.m_cycle + 1u > ready)
+            ready = vu.m_cycle + 1u;
+        return ready;
+    }
+
+    // ---- upper (FMAC) ---------------------------------------------------------------------------
+    static constexpr uint8_t laneBit(uint32_t c) { return static_cast<uint8_t>(8u >> c); }
+
+    // applyFmacDest no modo de matematica rapida: normaliza cada lane do dest, enfileira as flags e grava
+    static inline void fmacStore(VU1Interpreter &vu, float *dst, float *result, uint8_t dest)
+    {
+        uint8_t laneFlags[4] = {0, 0, 0, 0};
+        for (uint32_t c = 0; c < 4u; ++c)
+        {
+            if ((dest & laneBit(c)) == 0u)
+                continue;
+            uint32_t flags = 0u;
+            result[c] = vu.normalizeResult(result[c], flags);
+            laneFlags[c] = static_cast<uint8_t>(flags);
+        }
+        fmacFlags(vu, laneFlags, dest);
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (dest & laneBit(c))
+                dst[c] = result[c];
+    }
+
+    // updateFmacFlags (extraSticky = 0) inline: slot livre achado pela mascara de ocupados
+    static inline void fmacFlags(VU1Interpreter &vu, const uint8_t laneFlags[4], uint8_t dest)
+    {
+        if (dest == 0u)
+            return;
+        uint32_t mac = 0u;
+        uint32_t status = 0u;
+        for (uint32_t c = 0; c < 4u; ++c)
+        {
+            const uint32_t lane = laneBit(c);
+            if ((dest & lane) == 0u)
+                continue;
+            const uint32_t flags = laneFlags[c];
+            if (flags & 0x1u) mac |= lane;
+            if (flags & 0x2u) mac |= lane << 4;
+            if (flags & 0x4u) mac |= lane << 8;
+            if (flags & 0x8u) mac |= lane << 12;
+            status |= flags;
+        }
+        const uint32_t freeMask = ~vu.m_flagValidMask & ((1u << VU1Interpreter::kMaxFlagEntries) - 1u);
+        if (freeMask == 0u)
+        {
+            vu.updateFmacFlags(laneFlags, dest, 0u); // caminho original (reporta estouro)
+            return;
+        }
+        const uint32_t slot = static_cast<uint32_t>(std::countr_zero(freeMask));
+        auto &entry = vu.m_flagPipeline[slot];
+        entry = {};
+        entry.valid = true;
+        vu.m_flagValidMask |= 1u << slot;
+        entry.issueCycle = vu.m_cycle;
+        entry.readyCycle = vu.m_cycle + VU1Interpreter::kFmacLatency;
+        if (entry.readyCycle < vu.m_nextCommitCycle)
+            vu.m_nextCommitCycle = entry.readyCycle;
+        entry.mac = mac;
+        entry.status = status;
+        entry.writesMac = true;
+        entry.writesStatus = true;
+    }
+
+    // advanceOneCycle inline (commit so quando algo fica pronto; XGKICK so se ativo)
+    static inline void advanceOneCycle(VU1Interpreter &vu)
+    {
+        ++vu.m_cycle;
+        vu.m_state.cycles = vu.m_cycle;
+        if (vu.m_cycle >= vu.m_nextCommitCycle)
+            vu.commitReadyPipelines();
+        if (vu.m_xgkick.active)
+            vu.progressXgkick();
+    }
+
+    static inline void plainStore(float *dst, const float *result, uint8_t dest)
+    {
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (dest & laneBit(c))
+                dst[c] = result[c];
+    }
+
+    template <uint32_t U>
+    static inline void upper(VU1Interpreter &vu)
