+std::string ps2_gs_stats::takeDrawSummary()
+{
+    std::map<uint64_t, uint64_t> stats;
+    std::map<std::string, uint64_t> events;
+    {
+        std::lock_guard<std::mutex> lock(g_drawStatsMutex);
+        stats.swap(g_drawStats);
+        events.swap(g_eventStats);
+    }
+    std::ostringstream out;
+    for (const auto &[name, count] : events)
+    {
+        out << " " << name << "=" << count;
+    }
+    out << std::hex;
+    for (const auto &[key, count] : stats)
+    {
+        out << " fbp=0x" << (key >> 40) << "/psm=0x" << ((key >> 32) & 0xFFu) << "/msk=0x" << (key & 0xFFFFFFFFu)
+            << ":" << std::dec << count << std::hex;
+    }
+    return out.str();
+}
