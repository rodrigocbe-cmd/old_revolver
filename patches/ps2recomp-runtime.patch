+void EeScheduler::dispatchGsIrqIfPending()
+{
+    // INTC cause 0 (GS): raised while GS_CSR has SIGNAL/FINISH set and GS_IMR does not mask it.
+    // The GS frontend only latches the CSR bits; the guest handler acknowledges by writing CSR.
+    // Polled at VBlank start/end, which bounds the latency to half a field.
+    GSRegisters &gs = m_runtime.memory().gs();
+    const uint64_t csr = gs.csr.load(std::memory_order_acquire);
+    const uint64_t imr = gs.imr;
+    const bool signalPending = (csr & 0x1u) != 0u && (imr & 0x100u) == 0u;
+    const bool finishPending = (csr & 0x2u) != 0u && (imr & 0x200u) == 0u;
+    if (signalPending || finishPending)
+    {
+        if (finishPending)
+            ps2_gs_stats::countEvent("gs.finish_irq");
+        dispatchIrq(false, 0u);
+    }
