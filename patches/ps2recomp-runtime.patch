+        bool on_finish(uint64_t) override
+        {
+            ps2_gs_stats::countEvent("gs.finish");
+            if (regs)
+            {
+                ps2GsNoteFinish();
+                regs->csr.fetch_or(0x2);
+            }
+            if (wake)
+                wake();
+            return false;
+        }
+
+        void (*wake)() = nullptr;
+
+        bool on_label(uint64_t value) override
+        {
+            if (regs)
+            {
+                const uint32_t id = static_cast<uint32_t>(value);
+                const uint32_t mask = static_cast<uint32_t>(value >> 32);
+                uint32_t hi = static_cast<uint32_t>(regs->siglblid >> 32);
+                hi = (hi & ~mask) | (id & mask);
+                regs->siglblid = (static_cast<uint64_t>(hi) << 32) | (regs->siglblid & 0xFFFFFFFFull);
+            }
+            return false;
+        }
+    };
