+    float asFloat = 0.0f;
+    const uint32_t low32 = static_cast<uint32_t>(valueLo);
+    std::memcpy(&asFloat, &low32, sizeof(asFloat));
+    std::fprintf(stderr, "[write-watch] pc=0x%06x ra=0x%06x %s addr=0x%08x size=%u lo=0x%016llx hi=0x%016llx (f=%g)\n", pc,
+                 ra, op, guestAddr, size, static_cast<unsigned long long>(valueLo),
+                 static_cast<unsigned long long>(valueHi), asFloat);
